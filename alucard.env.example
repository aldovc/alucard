GITHUB_TOKEN=
ANTHROPIC_API_KEY=

# OpenAI API key — required when any provider var below is set to "codex"
OPENAI_API_KEY=

# Default AI provider for all roles; recognized values: claude (default), codex
ALUCARD_PROVIDER=

# Per-role provider overrides — each defaults to $ALUCARD_PROVIDER when unset
ALUCARD_WORKER_PROVIDER=
ALUCARD_CI_FIX_PROVIDER=
ALUCARD_REVIEWER_PROVIDER=
ALUCARD_FEEDBACK_PROVIDER=

# Codex model to use when a role is set to "codex" (default: gpt-5.6-terra)
ALUCARD_CODEX_MODEL=

# Claude model + fallback model for all roles (Claude provider only)
# ALUCARD_CLAUDE_MODEL=sonnet
# ALUCARD_CLAUDE_FALLBACK_MODEL=haiku

# Claude --effort level for all roles (Claude provider only). Unset omits
# the --effort flag entirely, preserving the CLI's own default.
# ALUCARD_EFFORT=

# Per-role overrides for the four settings above — each falls back to its
# matching global var, then its default. ROLE is WORKER, CI_FIX, REVIEWER,
# or FEEDBACK. Unlike provider vars, these are not validated: pass through
# whatever the underlying CLI accepts.
# ALUCARD_WORKER_CLAUDE_MODEL=
# ALUCARD_WORKER_CLAUDE_FALLBACK_MODEL=
# ALUCARD_WORKER_EFFORT=
# ALUCARD_WORKER_CODEX_MODEL=
# ALUCARD_CI_FIX_CLAUDE_MODEL=
# ALUCARD_CI_FIX_CLAUDE_FALLBACK_MODEL=
# ALUCARD_CI_FIX_EFFORT=
# ALUCARD_CI_FIX_CODEX_MODEL=
# ALUCARD_REVIEWER_CLAUDE_MODEL=
# ALUCARD_REVIEWER_CLAUDE_FALLBACK_MODEL=
# ALUCARD_REVIEWER_EFFORT=
# ALUCARD_REVIEWER_CODEX_MODEL=
# ALUCARD_FEEDBACK_CLAUDE_MODEL=
# ALUCARD_FEEDBACK_CLAUDE_FALLBACK_MODEL=
# ALUCARD_FEEDBACK_EFFORT=
# ALUCARD_FEEDBACK_CODEX_MODEL=

# Per-role --max-turns / --max-budget-usd overrides (Claude provider only)
# ALUCARD_WORKER_MAX_TURNS=180
# ALUCARD_WORKER_MAX_BUDGET=10
# ALUCARD_CI_FIX_MAX_TURNS=30
# ALUCARD_CI_FIX_MAX_BUDGET=2
# ALUCARD_REVIEWER_MAX_TURNS=20
# ALUCARD_REVIEWER_MAX_BUDGET=2
# ALUCARD_FEEDBACK_MAX_TURNS=50
# ALUCARD_FEEDBACK_MAX_BUDGET=2

# Extra attempts after a transport-classified worker failure (dropped
# connection, overload, rate-limit) on the same ticket, before falling
# through to the existing recovery path. Default: 2 (3 total attempts).
# ALUCARD_TRANSPORT_RETRY_ATTEMPTS=2
