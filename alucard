#!/bin/bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
TOOL_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

DEFAULT_IMAGE="${ALUCARD_IMAGE:-ghcr.io/aldovc/alucard:latest}"
DEFAULT_ENV_FILE="${ALUCARD_ENV_FILE:-$TOOL_DIR/alucard.env}"
DEFAULT_BASE_BRANCH="${ALUCARD_BASE_BRANCH:-main}"
DEFAULT_LOG_ROOT="${ALUCARD_LOG_ROOT:-$TOOL_DIR/logs}"
DEFAULT_CACHE_DIR="${ALUCARD_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/alucard}"

usage() {
  cat <<'EOF'
Usage:
  alucard run [TARGET_REPO] [options]
  alucard queue [TARGET_REPO] [options]
  alucard build [options]
  alucard doctor [TARGET_REPO] [options]

TARGET_REPO accepts:
  /path/to/local/repo          existing local git clone
  owner/repo                   GitHub shorthand — auto-cloned on first run
  https://github.com/owner/repo  full GitHub HTTPS URL

Commands:
  run       Run the autonomous worker loop.
  queue     Print the currently eligible AFK issue queue as JSON.
  build     Build the Alucard Docker image.
  doctor    Check local prerequisites without running the worker.

Run options:
  -C, --repo PATH              Target git repository. Defaults to
                               ALUCARD_TARGET_REPO or the current directory.
  -n, --iterations N           Max iterations to run. Default: 20.
  -t, --timeout-minutes N      Per-iteration timeout. Default: 30.
      --base BRANCH            Base branch on origin. Default: main.
      --env-file PATH          Credential env file. Default: ./alucard.env
                               beside this CLI.
      --image NAME             Docker image name. Default: ghcr.io/aldovc/alucard:latest.
      --logs-root PATH         Directory for run logs. Default: ./logs beside
                               this CLI.
      --max-review-cycles N    Max reviewer→feedback loops per PR. Default: 2.
      --no-build               Do not build the image if it is missing.

Environment:
  ALUCARD_CACHE_DIR            Where GitHub repos are cached on first run.
                               Default: ~/.cache/alucard  (XDG_CACHE_HOME honoured)

Examples:
  alucard run owner/repo --iterations 1
  alucard run /path/to/target-repo --iterations 1 --timeout-minutes 10
  ALUCARD_TARGET_REPO=/path/to/target-repo alucard run -n 20 -t 30
  cd /path/to/target-repo && alucard queue
EOF
}

die() {
  echo "alucard: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

is_uint() {
  [[ "${1:-}" =~ ^[0-9]+$ ]]
}

xml_escape() {
  sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

# Extracts "owner/repo" from a GitHub ref, or returns empty for local paths.
is_github_ref() {
  local input="${1%.git}"  # strip trailing .git before matching
  if [[ "$input" =~ ^git@github\.com:([a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+)$ ]]; then
    echo "${BASH_REMATCH[1]}"
  elif [[ "$input" =~ ^https://github\.com/([a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+)$ ]]; then
    echo "${BASH_REMATCH[1]}"
  elif [[ "$input" =~ ^([a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+)$ ]]; then
    echo "${BASH_REMATCH[1]}"
  fi
}

resolve_repo() {
  local repo="$1"

  # Prefer local path resolution over owner/repo shorthand.
  if [ -d "$repo" ]; then
    git -C "$repo" rev-parse --show-toplevel 2>/dev/null \
      || die "target path is not inside a git repo: $repo"
    return
  fi

  local owner_repo
  owner_repo="$(is_github_ref "$repo")"

  if [ -n "$owner_repo" ]; then
    local cache_path="${DEFAULT_CACHE_DIR}/$owner_repo"
    if [ -d "$cache_path/.git" ]; then
      echo "Refreshing cached clone of $owner_repo..." >&2
      git -C "$cache_path" fetch --quiet origin
    else
      echo "Cloning $owner_repo into $cache_path..." >&2
      mkdir -p "$(dirname "$cache_path")"
      # For explicit SSH URLs, preserve the transport so host SSH keys are used.
      local clone_url
      if [[ "$repo" =~ ^git@github\.com: ]]; then
        clone_url="$repo"
      else
        clone_url="https://github.com/$owner_repo.git"
      fi
      git clone --quiet "$clone_url" "$cache_path"
    fi
    echo "$cache_path"
    return
  fi

  die "target repo does not exist: $repo"
}

load_env_file() {
  local env_file="$1"
  local require="$2"

  if [ ! -f "$env_file" ]; then
    [ "$require" = "false" ] && return 0
    die "missing env file: $env_file"
  fi

  set -a
  # shellcheck disable=SC1090
  source "$env_file"
  set +a

  if [ "$require" = "true" ]; then
    [ -n "${GITHUB_TOKEN:-}" ] || die "GITHUB_TOKEN is empty in $env_file"
    [ -n "${ANTHROPIC_API_KEY:-}" ] || die "ANTHROPIC_API_KEY is empty in $env_file"
  fi
}

ensure_image() {
  local image="$1"
  local auto_build="$2"

  need_cmd docker
  if docker image inspect "$image" >/dev/null 2>&1; then
    return 0
  fi

  [ "$auto_build" = "true" ] || die "Docker image not found: $image"
  echo "Building $image from $TOOL_DIR..."
  docker build -t "$image" "$TOOL_DIR"
}

parse_repo_options() {
  TARGET_REPO="${ALUCARD_TARGET_REPO:-$PWD}"
  IMAGE="$DEFAULT_IMAGE"
  ENV_FILE="$DEFAULT_ENV_FILE"
  BASE_BRANCH="$DEFAULT_BASE_BRANCH"
  LOG_ROOT="$DEFAULT_LOG_ROOT"
  ITERATIONS=20
  TIMEOUT_MIN=30
  MAX_REVIEW_CYCLES=2
  AUTO_BUILD=true
  TARGET_REPO_SET=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -C|--repo)
        [ -n "${2:-}" ] || die "$1 requires a path"
        TARGET_REPO="$2"
        TARGET_REPO_SET=true
        shift 2
        ;;
      -n|--iterations)
        [ -n "${2:-}" ] || die "$1 requires a number"
        is_uint "$2" || die "iterations must be a positive integer"
        ITERATIONS="$2"
        shift 2
        ;;
      -t|--timeout-minutes)
        [ -n "${2:-}" ] || die "$1 requires a number"
        is_uint "$2" || die "timeout must be a positive integer"
        TIMEOUT_MIN="$2"
        shift 2
        ;;
      --base)
        [ -n "${2:-}" ] || die "$1 requires a branch name"
        BASE_BRANCH="$2"
        shift 2
        ;;
      --env-file)
        [ -n "${2:-}" ] || die "$1 requires a path"
        ENV_FILE="$2"
        shift 2
        ;;
      --image)
        [ -n "${2:-}" ] || die "$1 requires an image name"
        IMAGE="$2"
        shift 2
        ;;
      --logs-root)
        [ -n "${2:-}" ] || die "$1 requires a path"
        LOG_ROOT="$2"
        shift 2
        ;;
      --max-review-cycles)
        [ -n "${2:-}" ] || die "$1 requires a number"
        is_uint "$2" || die "max-review-cycles must be a positive integer"
        MAX_REVIEW_CYCLES="$2"
        shift 2
        ;;
      --no-build)
        AUTO_BUILD=false
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --)
        shift
        [ "$#" -eq 0 ] || die "unexpected arguments after --: $*"
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        [ "$TARGET_REPO_SET" = "false" ] || die "unexpected argument: $1"
        TARGET_REPO="$1"
        TARGET_REPO_SET=true
        shift
        ;;
    esac
  done
}

get_unblocked_afk_issues() {
  local repo_abs="$1"
  local all open_prs issue body blockers blocked state skip num has_pr _gh_repo owner repo

  all=$(cd "$repo_abs" && gh issue list --state open --label afk --limit 500 \
        --json number,title,body,labels)

  # Use GitHub's own closing-issue graph so PR detection is never left to LLM
  # output format — GitHub parses the PR body; we just read the result.
  _gh_repo=$(cd "$repo_abs" && gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  owner="${_gh_repo%%/*}"
  repo="${_gh_repo#*/}"
  open_prs="[]"
  if [ -n "$owner" ] && [ -n "$repo" ]; then
    open_prs=$(cd "$repo_abs" && gh api graphql \
      -f query='query($owner:String!,$repo:String!){
        repository(owner:$owner,name:$repo){
          pullRequests(states:OPEN,first:100){
            nodes{number,closingIssuesReferences(first:25){nodes{number}}}
          }
        }
      }' \
      -f owner="$owner" -f repo="$repo" \
      --jq '.data.repository.pullRequests.nodes' 2>/dev/null || echo "[]")
  fi

  echo "$all" | jq -c '.[]' | while read -r issue; do
    body=$(echo "$issue" | jq -r '.body // ""')
    blockers=$(echo "$body" | grep -oE 'Blocked by #[0-9]+' \
               | grep -oE '[0-9]+' || true)

    blocked=false
    for b in $blockers; do
      state=$(cd "$repo_abs" && gh issue view "$b" --json state -q .state 2>/dev/null || echo "OPEN")
      [ "$state" = "OPEN" ] && { blocked=true; break; }
    done

    skip=$(echo "$issue" | jq -r '
      .labels | map(.name) | any(. == "in-progress" or . == "wip")')

    # Skip if GitHub's own closing-issue graph links an open PR to this issue.
    if [ "$skip" = "false" ]; then
      num=$(echo "$issue" | jq -r '.number')
      has_pr=$(echo "$open_prs" | jq --argjson n "$num" \
        '[.[] | select((.closingIssuesReferences.nodes // []) | map(.number) | contains([$n]))] | length')
      [ "${has_pr:-0}" -gt 0 ] && skip="true"
    fi

    if [ "$blocked" = false ] && [ "$skip" = "false" ]; then
      echo "$issue"
    fi
  done | jq -s '.'
}

print_usage_report() {
  local log_dir="$1"

  [ -d "$log_dir" ] || return 0

  local -a labels inps outs crs cws turnss costs
  local f base label mid
  local total_inp=0 total_out=0 total_cr=0 total_cw=0 total_turns=0
  local total_cost="0"

  while IFS= read -r f; do
    base=$(basename "$f" .jsonl)
    case "$base" in
      iter-*-fix-*)
        mid="${base#iter-}"; label="ci-fix ${mid/-fix-/.}" ;;
      iter-*-review-*)
        mid="${base#iter-}"; label="review ${mid/-review-/.}" ;;
      iter-*-feedback-*)
        mid="${base#iter-}"; label="feedback ${mid/-feedback-/.}" ;;
      iter-*)
        label="worker ${base#iter-}" ;;
      *)
        label="$base" ;;
    esac

    local inp out cr cw turns cost
    # read returns non-zero on empty input; guard with || true so set -e doesn't
    # abort the report when a log has no result line (timeout, Ctrl+C, etc.)
    IFS=$'\t' read -r inp out cr cw turns cost < <(
      tail -n 20 "$f" | grep '"type":"result"' | tail -1 \
        | jq -r 'select(.type == "result") |
            ([ .modelUsage // {} | to_entries[] | .value ] as $m |
            [
              ([$m[].inputTokens            // 0] | add // 0),
              ([$m[].outputTokens           // 0] | add // 0),
              ([$m[].cacheReadInputTokens   // 0] | add // 0),
              ([$m[].cacheCreationInputTokens // 0] | add // 0),
              (.num_turns // 0),
              (.total_cost_usd // 0)
            ]) | @tsv' 2>/dev/null || true
    ) || true

    [ -z "${inp:-}" ] && continue

    labels+=("$label")
    inps+=("$inp")
    outs+=("$out")
    crs+=("$cr")
    cws+=("$cw")
    turnss+=("$turns")
    costs+=("$cost")

    total_inp=$((total_inp + inp))
    total_out=$((total_out + out))
    total_cr=$((total_cr + cr))
    total_cw=$((total_cw + cw))
    total_turns=$((total_turns + turns))
    total_cost=$(awk "BEGIN { printf \"%.4f\", $total_cost + $cost }")
  done < <(find "$log_dir" -maxdepth 1 -name '*.jsonl' 2>/dev/null | sort -V)

  [ "${#labels[@]}" -eq 0 ] && return 0

  local sep
  sep=$(printf '%86s' '' | tr ' ' '-')

  printf '\n=== Alucard Token Usage: %s ===\n' "$(basename "$log_dir")"
  printf '%-22s  %10s  %8s  %12s  %12s  %5s  %8s\n' \
    "Agent" "Input" "Output" "Cache Read" "Cache Write" "Turns" "Cost"
  printf '%s\n' "$sep"

  local i
  for i in "${!labels[@]}"; do
    printf '%-22s  %10s  %8s  %12s  %12s  %5s  %8s\n' \
      "${labels[$i]}" "${inps[$i]}" "${outs[$i]}" "${crs[$i]}" "${cws[$i]}" \
      "${turnss[$i]}" "$(printf '$%.3f' "${costs[$i]}")"
  done

  printf '%s\n' "$sep"
  printf '%-22s  %10s  %8s  %12s  %12s  %5s  %8s\n' \
    "TOTAL" "$total_inp" "$total_out" "$total_cr" "$total_cw" "$total_turns" \
    "$(printf '$%.3f' "$total_cost")"
  printf '\n'
}

command_build() {
  IMAGE="$DEFAULT_IMAGE"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --image)
        [ -n "${2:-}" ] || die "$1 requires an image name"
        IMAGE="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown build option: $1"
        ;;
    esac
  done

  need_cmd docker
  docker build -t "$IMAGE" "$TOOL_DIR"
}

command_queue() {
  parse_repo_options "$@"
  need_cmd git
  need_cmd gh
  need_cmd jq

  REPO_ABS=$(resolve_repo "$TARGET_REPO")
  load_env_file "$ENV_FILE" false
  get_unblocked_afk_issues "$REPO_ABS"
}

command_doctor() {
  parse_repo_options "$@"

  local ok=true
  for cmd in git gh jq docker timeout; do
    if command -v "$cmd" >/dev/null 2>&1; then
      echo "ok: $cmd"
    else
      echo "missing: $cmd"
      ok=false
    fi
  done

  local _missing_files=false
  for _f in Dockerfile entrypoint.sh \
             alucard-worker-prompt.md alucard-reviewer-prompt.md \
             alucard-ci-fix-prompt.md alucard-feedback-prompt.md; do
    if [ ! -f "$TOOL_DIR/$_f" ]; then
      echo "missing: $TOOL_DIR/$_f"
      _missing_files=true
    fi
  done
  if [ "$_missing_files" = "false" ]; then
    echo "ok: tool files in $TOOL_DIR"
  else
    ok=false
  fi

  if [ -f "$ENV_FILE" ]; then
    echo "ok: env file $ENV_FILE"
    load_env_file "$ENV_FILE" false
    [ -n "${GITHUB_TOKEN:-}" ] || { echo "missing: GITHUB_TOKEN value"; ok=false; }
    [ -n "${ANTHROPIC_API_KEY:-}" ] || { echo "missing: ANTHROPIC_API_KEY value"; ok=false; }
  else
    echo "missing: env file $ENV_FILE"
    ok=false
  fi

  local _owner_repo
  if [ -d "$TARGET_REPO" ] && REPO_ABS=$(git -C "$TARGET_REPO" rev-parse --show-toplevel 2>/dev/null); then
    echo "ok: target repo $REPO_ABS"
    if git -C "$REPO_ABS" config --get remote.origin.url >/dev/null; then
      echo "ok: target repo has origin remote"
    else
      echo "missing: target repo origin remote"
      ok=false
    fi
  elif _owner_repo="$(is_github_ref "$TARGET_REPO")" && [ -n "$_owner_repo" ]; then
    if gh repo view "$_owner_repo" --json name >/dev/null 2>&1; then
      echo "ok: target repo is GitHub ref $_owner_repo (cache: ${DEFAULT_CACHE_DIR}/$_owner_repo)"
    else
      echo "missing: cannot reach GitHub repo $_owner_repo (check GITHUB_TOKEN and network)"
      ok=false
    fi
  else
    echo "missing: valid target git repo at $TARGET_REPO (or a GitHub ref like owner/repo)"
    ok=false
  fi

  if docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "ok: Docker image $IMAGE"
  else
    echo "missing: Docker image $IMAGE (run: docker pull ghcr.io/aldovc/alucard:latest, or alucard build for a local image)"
  fi

  [ "$ok" = "true" ] || exit 1
}

command_run() {
  parse_repo_options "$@"

  need_cmd git
  need_cmd gh
  need_cmd jq
  need_cmd docker
  need_cmd timeout

  [ "$ITERATIONS" -gt 0 ] || die "iterations must be greater than zero"
  [ "$TIMEOUT_MIN" -gt 0 ] || die "timeout must be greater than zero"

  REPO_ABS=$(resolve_repo "$TARGET_REPO")
  [ -d "$(dirname "$ENV_FILE")" ] || die "env file directory does not exist: $(dirname "$ENV_FILE")"
  ENV_FILE="$(cd "$(dirname "$ENV_FILE")" && pwd)/$(basename "$ENV_FILE")"
  LOG_ROOT="$(mkdir -p "$LOG_ROOT" && cd "$LOG_ROOT" && pwd)"
  LOG_DIR="$LOG_ROOT/alucard-$(date +%Y%m%d-%H%M%S)"
  WT_ROOT="${REPO_ABS}/.alucard-worktrees"

  mkdir -p "$LOG_DIR" "$WT_ROOT"
  load_env_file "$ENV_FILE" true
  ensure_image "$IMAGE" "$AUTO_BUILD"

  stream_text='select(.type == "stream_event" and .event.type == "content_block_delta" and .event.delta.type == "text_delta") | .event.delta.text'
  final_result='select(.type == "result").result // empty'
  CREATED_WORKTREES=()

  # Run a fresh fix agent on the branch if CI fails after a PR is opened.
  # $1 = iteration index, $2 = branch name, $3 = origin HTTPS URL
  ci_gate() {
    local iter="$1" branch="$2" origin_url="$3"

    local pr_num
    pr_num=$(cd "$REPO_ABS" && \
      gh pr list --head "$branch" --state open --json number \
        --jq '.[0].number // empty' 2>/dev/null || true)

    [ -n "${pr_num:-}" ] || return 0

    echo "=== CI gate: PR #$pr_num on $branch ==="

    local ci_attempt ci_rc failed_run_id failure_log wt_fix fix_log fix_rc _ci_err_file _ci_err pr_head_sha
    for ci_attempt in 1 2 3; do
      # Refresh each attempt so a fix-agent push moves to the new HEAD SHA.
      pr_head_sha=$(cd "$REPO_ABS" && \
        gh pr view "$pr_num" --json headRefOid --jq '.headRefOid' 2>/dev/null || true)
      echo "Polling CI (attempt $ci_attempt/3)..."
      _ci_err_file="$(mktemp /tmp/alucard_ci_err.XXXXXX)"
      set +e
      (cd "$REPO_ABS" && timeout 2700 gh pr checks "$pr_num" --watch --interval 30) \
        2>"$_ci_err_file"
      ci_rc=$?
      _ci_err="$(cat "$_ci_err_file" 2>/dev/null || true)"
      rm -f "$_ci_err_file"
      [ -n "$_ci_err" ] && echo "$_ci_err" >&2
      set -e

      # No CI workflows configured (or none triggered for this PR's changed
      # paths) — treat as a pass. Without this, `gh pr checks --watch` exits 1
      # with "no checks reported", which falls through to the fix-agent loop
      # and burns budget trying to repair CI that does not exist.
      if [ "$ci_rc" -ne 0 ] && echo "$_ci_err" | grep -q "no checks reported"; then
        echo "No checks configured for PR #$pr_num — skipping CI gate."
        ci_rc=0
      fi

      # Token lacks 'checks' read permission — fall back to polling gh run list.
      if [ "$ci_rc" -ne 0 ] && echo "$_ci_err" | grep -q "Resource not accessible"; then
        echo "Token lacks 'checks' read permission — falling back to gh run list for PR #$pr_num..."
        local deadline=$(( $(date +%s) + 2700 ))
        ci_rc=1
        local _found_runs=false
        while [ "$(date +%s)" -lt "$deadline" ]; do
          local run_json
          run_json=$(cd "$REPO_ABS" && \
            gh run list --branch "$branch" --json status,conclusion,databaseId,headSha \
              --jq '[.[] | select(.status != "queued")]' 2>/dev/null || echo "[]")
          if [ -n "${pr_head_sha:-}" ]; then
            run_json=$(echo "$run_json" | jq --arg sha "$pr_head_sha" '[.[] | select(.headSha == $sha)]')
          fi
          local total in_progress failed
          total=$(echo "$run_json" | jq 'length')
          in_progress=$(echo "$run_json" | jq '[.[] | select(.status != "completed")] | length')
          failed=$(echo "$run_json" | jq '[.[] | select(.conclusion == "failure" or .conclusion == "timed_out")] | length')
          if [ "$total" -eq 0 ]; then
            echo "No workflow runs found yet — waiting..."
            sleep 30; continue
          fi
          _found_runs=true
          if [ "$in_progress" -gt 0 ]; then
            echo "Runs still in progress ($in_progress/$total) — waiting..."
            sleep 30; continue
          fi
          if [ "$failed" -gt 0 ]; then
            ci_rc=1
          else
            ci_rc=0
          fi
          break
        done
        # No runs appeared during the entire polling window — token likely also
        # lacks 'actions' read permission. Skip rather than fire spurious fix agents.
        if [ "$_found_runs" = "false" ]; then
          echo "No CI runs visible for PR #$pr_num (token may lack 'actions' read permission) — skipping CI gate."
          ci_rc=0
        fi
      fi

      if [ "$ci_rc" -eq 0 ]; then
        echo "CI green — PR #$pr_num ready for review."
        return 0
      fi

      if [ "$ci_attempt" -eq 3 ]; then
        echo "CI still failing after 3 fix attempts — PR #$pr_num left open for manual review."
        return 0
      fi

      echo "CI failed (attempt $ci_attempt) — launching fix agent..."

      failed_run_id=$(cd "$REPO_ABS" && \
        gh run list --branch "$branch" --json databaseId,conclusion,headSha \
          --jq --arg sha "${pr_head_sha:-}" \
          '[.[] | select(.conclusion=="failure" and ($sha == "" or .headSha == $sha))] | .[0].databaseId // empty' \
          2>/dev/null || true)
      failure_log=""
      if [ -n "${failed_run_id:-}" ]; then
        failure_log=$(cd "$REPO_ABS" && \
          gh run view "$failed_run_id" --log-failed 2>/dev/null | head -400 || true)
      fi

      wt_fix="${WT_ROOT}/fix-${iter}-${ci_attempt}"
      CREATED_WORKTREES+=("$wt_fix")
      rm -rf "$wt_fix"
      git -C "$REPO_ABS" fetch origin "$branch"
      # fetch only creates origin/$branch; create a local branch so --local clone can find it
      git -C "$REPO_ABS" branch --force "$branch" "origin/$branch"
      git clone --local --no-tags --single-branch --branch "$branch" "$REPO_ABS" "$wt_fix"
      git -C "$wt_fix" remote set-url origin "$origin_url"

      fix_log="$LOG_DIR/iter-${iter}-fix-${ci_attempt}.jsonl"

      set +e
      timeout "${TIMEOUT_MIN}m" docker run --rm \
        --name "alucard-fix-${iter}-${ci_attempt}" \
        --network bridge \
        --memory 4g --cpus 2 \
        --read-only \
        --tmpfs /tmp:exec,size=1g \
        --tmpfs /home/alucard:size=1g,uid="$(id -u)",gid="$(id -g)" \
        --user "$(id -u):$(id -g)" \
        --security-opt no-new-privileges \
        --cap-drop ALL \
        -v "$wt_fix:/work:rw" \
        --env-file "$ENV_FILE" \
        -e "ALUCARD_ITER=${iter}-fix-${ci_attempt}" \
        -e "HOME=/home/alucard" \
        -e "GIT_CONFIG_GLOBAL=/tmp/alucard-gitconfig" \
        -e "GH_CONFIG_DIR=/tmp/gh" \
        "$IMAGE" \
        claude -p \
          --verbose \
          --output-format stream-json \
          --include-partial-messages \
          --permission-mode bypassPermissions \
          --max-turns 30 \
          --max-budget-usd 2 \
          --fallback-model sonnet \
          --disallowedTools "Bash(rm -rf /*),Bash(sudo *),Bash(curl * | sh),Bash(curl * | bash),Bash(wget * | sh),Bash(dd if=*),Bash(mkfs*)" \
          -- \
          "<instructions>
$(<"$TOOL_DIR/alucard-ci-fix-prompt.md")
</instructions>
<pr_num>${pr_num}</pr_num>
<branch>${branch}</branch>
<failure_log>
$(printf '%s' "$failure_log" | xml_escape)
</failure_log>" \
        | grep --line-buffered '^{' \
        | tee "$fix_log" \
        | jq --unbuffered -rj "$stream_text"
      fix_rc=${PIPESTATUS[0]}
      set -e

      echo ""
      rm -rf "$wt_fix" || true

      [ "$fix_rc" -ne 0 ] && echo "Fix agent exited rc=$fix_rc on attempt $ci_attempt"
    done
  }

  # Run reviewer then feedback agents on the open PR, up to MAX_REVIEW_CYCLES times.
  # $1 = iteration index, $2 = branch name, $3 = origin HTTPS URL
  review_gate() {
    local iter="$1" branch="$2" origin_url="$3"

    local pr_num
    pr_num=$(cd "$REPO_ABS" && \
      gh pr list --head "$branch" --state open --json number \
        --jq '.[0].number // empty' 2>/dev/null || true)

    [ -n "${pr_num:-}" ] || return 0

    echo "=== Review gate: PR #$pr_num on $branch ==="

    local review_cycle wt_review review_log review_rc review_state review_comments wt_feedback feedback_log feedback_rc

    for review_cycle in $(seq 1 "$MAX_REVIEW_CYCLES"); do
      echo "Review cycle $review_cycle/$MAX_REVIEW_CYCLES — running reviewer agent..."

      wt_review="${WT_ROOT}/review-${iter}-${review_cycle}"
      local review_out_dir
      review_out_dir=$(mktemp -d /tmp/alucard_review.XXXXXX)
      CREATED_WORKTREES+=("$wt_review" "$review_out_dir")
      rm -rf "$wt_review"
      git -C "$REPO_ABS" fetch origin "$branch"
      git -C "$REPO_ABS" branch --force "$branch" "origin/$branch"
      git clone --local --no-tags --single-branch --branch "$branch" "$REPO_ABS" "$wt_review"
      git -C "$wt_review" remote set-url origin "$origin_url"

      review_log="$LOG_DIR/iter-${iter}-review-${review_cycle}.jsonl"

      set +e
      timeout "${TIMEOUT_MIN}m" docker run --rm \
        --name "alucard-review-${iter}-${review_cycle}" \
        --network bridge \
        --memory 4g --cpus 2 \
        --read-only \
        --tmpfs /tmp:exec,size=1g \
        --tmpfs /home/alucard:size=1g,uid="$(id -u)",gid="$(id -g)" \
        --user "$(id -u):$(id -g)" \
        --security-opt no-new-privileges \
        --cap-drop ALL \
        -v "$wt_review:/work:ro" \
        -v "$review_out_dir:/work-output:rw" \
        --env-file "$ENV_FILE" \
        -e "ALUCARD_ITER=${iter}-review-${review_cycle}" \
        -e "HOME=/home/alucard" \
        -e "GIT_CONFIG_GLOBAL=/tmp/alucard-gitconfig" \
        -e "GH_CONFIG_DIR=/tmp/gh" \
        "$IMAGE" \
        claude -p \
          --verbose \
          --output-format stream-json \
          --include-partial-messages \
          --permission-mode bypassPermissions \
          --max-turns 20 \
          --max-budget-usd 2 \
          --fallback-model sonnet \
          --disallowedTools "Bash(rm -rf /*),Bash(sudo *),Bash(curl * | sh),Bash(curl * | bash),Bash(wget * | sh),Bash(dd if=*),Bash(mkfs*)" \
          -- \
          "<instructions>
$(<"$TOOL_DIR/alucard-reviewer-prompt.md")
</instructions>
<pr_num>${pr_num}</pr_num>" \
        | grep --line-buffered '^{' \
        | tee "$review_log" \
        | jq --unbuffered -rj "$stream_text"
      review_rc=${PIPESTATUS[0]}
      set -e

      echo ""

      # Read reviewer output files (written to the separate rw output dir).
      local _review_file_state="" _review_file_body=""
      if [ -f "$review_out_dir/.alucard-review" ]; then
        _review_file_state=$(tr -d '[:space:]' < "$review_out_dir/.alucard-review")
      fi
      if [ -f "$review_out_dir/.alucard-review-body" ]; then
        _review_file_body=$(< "$review_out_dir/.alucard-review-body")
      fi

      rm -rf "$wt_review" "$review_out_dir" || true

      review_state=$(cd "$REPO_ABS" && \
        gh pr view "$pr_num" --json reviews \
          --jq '[.reviews[] | select(.state == "APPROVED" or .state == "CHANGES_REQUESTED")] | last | .state // empty' \
        2>/dev/null || true)

      review_comments=$(cd "$REPO_ABS" && \
        gh pr view "$pr_num" --json reviews \
          --jq '[.reviews[] | select(.state == "APPROVED" or .state == "CHANGES_REQUESTED")] | last | .body // ""' \
        2>/dev/null || true)

      # GitHub blocks formal self-review when the bot token == the PR author,
      # so most runs land here with no formal review on the PR. Trust the
      # reviewer's decision files (APPROVED or CHANGES_REQUESTED). The earlier
      # concern that file-APPROVED "silently skips the feedback loop" is moot:
      # skipping feedback is exactly the correct behavior for APPROVED, and
      # dropping the verdict entirely (the previous behavior) hid the reviewer's
      # reasoning from the operator without making the loop any safer. The real
      # mitigation for self-approval is the two-token reviewer identity tracked
      # as deferred item #5 in README.md.
      local _self_review_note=""
      if [ -z "$review_state" ] && \
         { [ "$_review_file_state" = "CHANGES_REQUESTED" ] || [ "$_review_file_state" = "APPROVED" ]; }; then
        review_state="$_review_file_state"
        review_comments="$_review_file_body"
        _self_review_note="

_(Self-review: GitHub blocked a formal \`gh pr review\` because the bot is also the PR author. Verdict and body come from the reviewer agent's decision file.)_"
        echo "No formal review found — using decision file: $review_state"
      fi

      if [ "$review_state" = "APPROVED" ]; then
        echo "PR #$pr_num approved — ready to merge."
        cd "$REPO_ABS" && gh pr comment "$pr_num" --body \
          "**🤖 Alucard review cycle ${review_cycle}/${MAX_REVIEW_CYCLES}: APPROVED**

${review_comments}${_self_review_note}" 2>/dev/null || true
        return 0
      fi

      if [ -z "$review_state" ]; then
        echo "Reviewer did not post a review (rc=$review_rc) — skipping review gate."
        cd "$REPO_ABS" && gh pr comment "$pr_num" --body \
          "**🤖 Alucard review cycle ${review_cycle}/${MAX_REVIEW_CYCLES}: no review posted** (rc=${review_rc})" \
          2>/dev/null || true
        return 0
      fi

      # CHANGES_REQUESTED path — post findings for audit before acting on them
      cd "$REPO_ABS" && gh pr comment "$pr_num" --body \
        "**🤖 Alucard review cycle ${review_cycle}/${MAX_REVIEW_CYCLES}: CHANGES_REQUESTED**

${review_comments}${_self_review_note}" 2>/dev/null || true

      if [ "$review_cycle" -eq "$MAX_REVIEW_CYCLES" ]; then
        echo "Max review cycles ($MAX_REVIEW_CYCLES) reached — PR #$pr_num left open for manual review."
        return 0
      fi

      echo "Changes requested — launching feedback agent (cycle $review_cycle)..."

      # Augment reviewer findings with human-authored PR comments so the
      # feedback agent sees the user's questions/asks alongside the reviewer's
      # findings. Note: alucard runs under a human PAT, so author-based filtering
      # would also drop legitimate human comments. Instead, filter by body prefix
      # — all wrapper-posted comments start with "**🤖 Alucard …**". Reviewer
      # prompt no longer falls back to `gh pr comment`, so this prefix uniquely
      # identifies bot-self comments going forward.
      local human_comments feedback_findings
      human_comments=$(cd "$REPO_ABS" && \
        gh pr view "$pr_num" --json comments --jq '.comments' 2>/dev/null \
        | jq -r '[.[] | select(.body | startswith("**🤖 Alucard") | not) | "- @\(.author.login) at \(.createdAt):\n\(.body)"] | join("\n\n")' \
        2>/dev/null || true)
      feedback_findings="$review_comments"
      if [ -n "$human_comments" ]; then
        feedback_findings="${feedback_findings}

---

## Additional human PR comments

Treat each as an additional finding when actionable and on-topic. Off-topic or out-of-scope comments should be acknowledged via \`gh pr comment\` rather than silently ignored.

${human_comments}"
      fi

      wt_feedback="${WT_ROOT}/feedback-${iter}-${review_cycle}"
      CREATED_WORKTREES+=("$wt_feedback")
      rm -rf "$wt_feedback"
      git -C "$REPO_ABS" fetch origin "$branch"
      git -C "$REPO_ABS" branch --force "$branch" "origin/$branch"
      git clone --local --no-tags --single-branch --branch "$branch" "$REPO_ABS" "$wt_feedback"
      git -C "$wt_feedback" remote set-url origin "$origin_url"

      feedback_log="$LOG_DIR/iter-${iter}-feedback-${review_cycle}.jsonl"

      set +e
      timeout "${TIMEOUT_MIN}m" docker run --rm \
        --name "alucard-feedback-${iter}-${review_cycle}" \
        --network bridge \
        --memory 4g --cpus 2 \
        --read-only \
        --tmpfs /tmp:exec,size=1g \
        --tmpfs /home/alucard:size=1g,uid="$(id -u)",gid="$(id -g)" \
        --user "$(id -u):$(id -g)" \
        --security-opt no-new-privileges \
        --cap-drop ALL \
        -v "$wt_feedback:/work:rw" \
        --env-file "$ENV_FILE" \
        -e "ALUCARD_ITER=${iter}-feedback-${review_cycle}" \
        -e "HOME=/home/alucard" \
        -e "GIT_CONFIG_GLOBAL=/tmp/alucard-gitconfig" \
        -e "GH_CONFIG_DIR=/tmp/gh" \
        "$IMAGE" \
        claude -p \
          --verbose \
          --output-format stream-json \
          --include-partial-messages \
          --permission-mode bypassPermissions \
          --max-turns 50 \
          --max-budget-usd 2 \
          --fallback-model sonnet \
          --disallowedTools "Bash(rm -rf /*),Bash(sudo *),Bash(curl * | sh),Bash(curl * | bash),Bash(wget * | sh),Bash(dd if=*),Bash(mkfs*)" \
          -- \
          "<instructions>
$(<"$TOOL_DIR/alucard-feedback-prompt.md")
</instructions>
<pr_num>${pr_num}</pr_num>
<branch>${branch}</branch>
<review_findings>
$(printf '%s' "$feedback_findings" | xml_escape)
</review_findings>" \
        | grep --line-buffered '^{' \
        | tee "$feedback_log" \
        | jq --unbuffered -rj "$stream_text"
      feedback_rc=${PIPESTATUS[0]}
      set -e

      echo ""
      rm -rf "$wt_feedback" || true

      [ "$feedback_rc" -ne 0 ] && echo "Feedback agent exited rc=$feedback_rc on cycle $review_cycle"

      # Re-check CI before the next reviewer sees the updated branch.
      ci_gate "$iter" "$branch" "$origin_url"
    done
  }

  cleanup() {
    local wt
    for wt in "${CREATED_WORKTREES[@]}"; do
      rm -rf "$wt"
    done
    print_usage_report "$LOG_DIR"
  }
  trap cleanup EXIT

  for ((i=1; i<=ITERATIONS; i++)); do
    echo "=== alucard iteration $i/$ITERATIONS ==="

    WT_HOST="${WT_ROOT}/iter-$i"
    BRANCH="alucard/iter-${i}-$(date +%s)"
    CREATED_WORKTREES+=("$WT_HOST")

    # Clean up any stale directory from a previous interrupted run.
    rm -rf "$WT_HOST"

    # Clone locally so the container gets a self-contained .git dir.
    # Worktrees leave a .git file pointing to the host path, which the
    # container cannot resolve.
    # Explicit refspec so the remote-tracking ref is updated without touching
    # the local branch (which may be checked out and thus un-forceable).
    git -C "$REPO_ABS" fetch origin "+refs/heads/$BASE_BRANCH:refs/remotes/origin/$BASE_BRANCH"
    git clone --local --no-tags --single-branch --branch "$BASE_BRANCH" "$REPO_ABS" "$WT_HOST"
    # The local branch may be behind; reset the clone to the exact fetched commit.
    git -C "$WT_HOST" reset --hard "$(git -C "$REPO_ABS" rev-parse "origin/$BASE_BRANCH")"
    # Always use HTTPS so the container can authenticate with GITHUB_TOKEN.
    # Convert git@github.com:owner/repo.git → https://github.com/owner/repo.git
    _origin_url="$(git -C "$REPO_ABS" remote get-url origin)"
    _origin_url="${_origin_url/git@github.com:/https://github.com/}"
    git -C "$WT_HOST" remote set-url origin "$_origin_url"
    git -C "$WT_HOST" checkout -b "$BRANCH"

    issues=$(get_unblocked_afk_issues "$REPO_ABS")
    count=$(echo "$issues" | jq 'length')

    if [ "$count" -eq 0 ]; then
      echo "Queue empty. Alucard rests after $((i-1)) iterations."
      rm -rf "$WT_HOST"
      exit 0
    fi

    commits=$(git -C "$REPO_ABS" log -n 5 --format="%H%n%ad%n%B---" --date=short "origin/$BASE_BRANCH")
    prompt=$(<"$TOOL_DIR/alucard-worker-prompt.md")
    log_file="$LOG_DIR/iter-${i}.jsonl"

    _commits_esc=$(printf '%s' "$commits" | xml_escape)
    _issues_esc=$(printf '%s' "$issues" | xml_escape)
    full_prompt="<instructions>${prompt}</instructions>
<base_branch>${BASE_BRANCH}</base_branch>
<commits>${_commits_esc}</commits>
<issues>${_issues_esc}</issues>"

    set +e
    timeout "${TIMEOUT_MIN}m" docker run --rm \
      --name "alucard-iter-$i" \
      --network bridge \
      --memory 4g --cpus 2 \
      --read-only \
      --tmpfs /tmp:exec,size=1g \
      --tmpfs /home/alucard:size=1g,uid="$(id -u)",gid="$(id -g)" \
      --user "$(id -u):$(id -g)" \
      --security-opt no-new-privileges \
      --cap-drop ALL \
      -v "$WT_HOST:/work:rw" \
      --env-file "$ENV_FILE" \
      -e "ALUCARD_ITER=$i" \
      -e "HOME=/home/alucard" \
      -e "GIT_CONFIG_GLOBAL=/tmp/alucard-gitconfig" \
      -e "GH_CONFIG_DIR=/tmp/gh" \
      "$IMAGE" \
      claude -p \
        --verbose \
        --output-format stream-json \
        --include-partial-messages \
        --permission-mode bypassPermissions \
        --max-turns 120 \
        --max-budget-usd 5 \
        --fallback-model sonnet \
        --disallowedTools "Bash(rm -rf /*),Bash(sudo *),Bash(curl * | sh),Bash(curl * | bash),Bash(wget * | sh),Bash(dd if=*),Bash(mkfs*)" \
        -- \
        "$full_prompt" \
      | grep --line-buffered '^{' \
      | tee "$log_file" \
      | jq --unbuffered -rj "$stream_text"
    rc=${PIPESTATUS[0]}
    set -e

    rm -rf "$WT_HOST" || true

    ci_gate "$i" "$BRANCH" "$_origin_url"
    review_gate "$i" "$BRANCH" "$_origin_url"

    if [ "$rc" -ne 0 ]; then
      echo "Iteration $i exited rc=$rc. Continuing."
      continue
    fi

    result=$(jq -r "$final_result" "$log_file" 2>/dev/null || echo "")
    if [[ "$result" == *"<promise>NO MORE TASKS</promise>"* ]]; then
      echo "Alucard signaled completion after $i iterations."
      exit 0
    fi
  done

  echo "Reached max iterations ($ITERATIONS)."
}

main() {
  if [ "$#" -eq 0 ]; then
    usage
    exit 0
  fi

  if is_uint "${1:-}"; then
    local old_iterations="$1"
    shift
    if is_uint "${1:-}"; then
      local old_timeout="$1"
      shift
      set -- run --iterations "$old_iterations" --timeout-minutes "$old_timeout" "$@"
    else
      set -- run --iterations "$old_iterations" "$@"
    fi
  fi

  local command="$1"
  shift || true

  case "$command" in
    run)
      command_run "$@"
      ;;
    queue)
      command_queue "$@"
      ;;
    build)
      command_build "$@"
      ;;
    doctor)
      command_doctor "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      if [ -d "$command" ]; then
        command_run "$command" "$@"
      else
        die "unknown command: $command"
      fi
      ;;
  esac
}

main "$@"
