#!/bin/bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
TOOL_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

DEFAULT_IMAGE="${ALUCARD_IMAGE:-ghcr.io/aldovc/alucard:latest}"
DEFAULT_ENV_FILE="${ALUCARD_ENV_FILE:-$TOOL_DIR/alucard.env}"
DEFAULT_BASE_BRANCH="${ALUCARD_BASE_BRANCH:-main}"
DEFAULT_LOG_ROOT="${ALUCARD_LOG_ROOT:-$TOOL_DIR/logs}"
DEFAULT_CACHE_DIR="${ALUCARD_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/alucard}"

# Per-role --max-turns / --max-budget-usd (Claude only) and the Claude
# model/fallback-model, all overridable so tuning doesn't require editing
# this script. Codex's equivalent knob is ALUCARD_CODEX_MODEL (see invoke_agent).
DEFAULT_WORKER_MAX_TURNS="${ALUCARD_WORKER_MAX_TURNS:-180}"
DEFAULT_WORKER_MAX_BUDGET="${ALUCARD_WORKER_MAX_BUDGET:-10}"
DEFAULT_CI_FIX_MAX_TURNS="${ALUCARD_CI_FIX_MAX_TURNS:-30}"
DEFAULT_CI_FIX_MAX_BUDGET="${ALUCARD_CI_FIX_MAX_BUDGET:-2}"
DEFAULT_REVIEWER_MAX_TURNS="${ALUCARD_REVIEWER_MAX_TURNS:-20}"
DEFAULT_REVIEWER_MAX_BUDGET="${ALUCARD_REVIEWER_MAX_BUDGET:-2}"
DEFAULT_FEEDBACK_MAX_TURNS="${ALUCARD_FEEDBACK_MAX_TURNS:-50}"
DEFAULT_FEEDBACK_MAX_BUDGET="${ALUCARD_FEEDBACK_MAX_BUDGET:-2}"
DEFAULT_CLAUDE_MODEL="${ALUCARD_CLAUDE_MODEL:-sonnet}"
DEFAULT_CLAUDE_FALLBACK_MODEL="${ALUCARD_CLAUDE_FALLBACK_MODEL:-haiku}"

# Refresh agent settings after an env file is sourced. This keeps inherited
# values working while allowing the selected env file to override them.
refresh_agent_settings() {
  DEFAULT_WORKER_MAX_TURNS="${ALUCARD_WORKER_MAX_TURNS:-$DEFAULT_WORKER_MAX_TURNS}"
  DEFAULT_WORKER_MAX_BUDGET="${ALUCARD_WORKER_MAX_BUDGET:-$DEFAULT_WORKER_MAX_BUDGET}"
  DEFAULT_CI_FIX_MAX_TURNS="${ALUCARD_CI_FIX_MAX_TURNS:-$DEFAULT_CI_FIX_MAX_TURNS}"
  DEFAULT_CI_FIX_MAX_BUDGET="${ALUCARD_CI_FIX_MAX_BUDGET:-$DEFAULT_CI_FIX_MAX_BUDGET}"
  DEFAULT_REVIEWER_MAX_TURNS="${ALUCARD_REVIEWER_MAX_TURNS:-$DEFAULT_REVIEWER_MAX_TURNS}"
  DEFAULT_REVIEWER_MAX_BUDGET="${ALUCARD_REVIEWER_MAX_BUDGET:-$DEFAULT_REVIEWER_MAX_BUDGET}"
  DEFAULT_FEEDBACK_MAX_TURNS="${ALUCARD_FEEDBACK_MAX_TURNS:-$DEFAULT_FEEDBACK_MAX_TURNS}"
  DEFAULT_FEEDBACK_MAX_BUDGET="${ALUCARD_FEEDBACK_MAX_BUDGET:-$DEFAULT_FEEDBACK_MAX_BUDGET}"
  DEFAULT_CLAUDE_MODEL="${ALUCARD_CLAUDE_MODEL:-$DEFAULT_CLAUDE_MODEL}"
  DEFAULT_CLAUDE_FALLBACK_MODEL="${ALUCARD_CLAUDE_FALLBACK_MODEL:-$DEFAULT_CLAUDE_FALLBACK_MODEL}"
}

usage() {
  cat <<'EOF'
Usage:
  alucard run [TARGET_REPO] [options]
  alucard queue [TARGET_REPO] [options]
  alucard build [options]
  alucard doctor [TARGET_REPO] [options]
  alucard continue <PR_NUM> [TARGET_REPO] [options]
  alucard version

TARGET_REPO accepts:
  /path/to/local/repo          existing local git clone
  owner/repo                   GitHub shorthand — auto-cloned on first run
  https://github.com/owner/repo  full GitHub HTTPS URL

Commands:
  run       Run the autonomous worker loop.
  queue     Print the currently eligible task queue as JSON — GitHub issues,
            or a local tasks file when one is configured or auto-detected.
  build     Build the Alucard Docker image.
  doctor    Check local prerequisites without running the worker.
  continue  Re-run the feedback+CI+review pipeline on a parked PR.
  version   Print the CLI version and exit.

Run options:
  -C, --repo PATH              Target git repository. Defaults to
                               ALUCARD_TARGET_REPO or the current directory.
  -n, --iterations N           Max iterations to run. Default: 20.
  -t, --timeout-minutes N      Per-iteration timeout. Default: 30.
      --base BRANCH            Base branch on origin. Default: main.
      --env-file PATH          Credential env file. Default: ./alucard.env
                               beside this CLI.
      --image NAME             Docker image name. Default: ghcr.io/aldovc/alucard:latest.
      --logs-root PATH         Directory for run logs. Default: ./logs beside
                               this CLI.
      --max-review-cycles N    Max reviewer→feedback loops per PR. Default: 10.
      --no-build               Do not build the image if it is missing or
                               stale. Warns instead of rebuilding.
      --tasks PATH             Read tasks from a local tasks file instead of
                               the GitHub issue queue. Defaults to
                               ALUCARD_TASKS_FILE, else auto-detects
                               .alucard/tasks.md in the target repo.
      --github                 Force the GitHub issue queue even when a local
                               tasks file exists.

Continue options:
  <PR_NUM>                     Open PR number to continue (required, positional).
  Same flags as run apply: -C, -t, --env-file, --image, --logs-root,
  --max-review-cycles, --no-build.

Environment:
  ALUCARD_CACHE_DIR            Where GitHub repos are cached on first run.
                               Default: ~/.cache/alucard  (XDG_CACHE_HOME honoured)
  ALUCARD_TASKS_FILE           Default tasks file for the local task source
                               (equivalent to passing --tasks).
  ALUCARD_CLAUDE_MODEL         Claude model for all agent roles. Default: sonnet
  ALUCARD_CLAUDE_FALLBACK_MODEL
                               Claude fallback model. Default: haiku
  ALUCARD_WORKER_MAX_TURNS     Worker --max-turns (Claude only). Default: 180
  ALUCARD_WORKER_MAX_BUDGET    Worker --max-budget-usd (Claude only). Default: 10
  ALUCARD_CI_FIX_MAX_TURNS     CI-fix --max-turns (Claude only). Default: 30
  ALUCARD_CI_FIX_MAX_BUDGET    CI-fix --max-budget-usd (Claude only). Default: 2
  ALUCARD_REVIEWER_MAX_TURNS   Reviewer --max-turns (Claude only). Default: 20
  ALUCARD_REVIEWER_MAX_BUDGET  Reviewer --max-budget-usd (Claude only). Default: 2
  ALUCARD_FEEDBACK_MAX_TURNS   Feedback --max-turns (Claude only). Default: 50
  ALUCARD_FEEDBACK_MAX_BUDGET  Feedback --max-budget-usd (Claude only). Default: 2

Examples:
  alucard run owner/repo --iterations 1
  alucard run /path/to/target-repo --iterations 1 --timeout-minutes 10
  ALUCARD_TARGET_REPO=/path/to/target-repo alucard run -n 20 -t 30
  cd /path/to/target-repo && alucard queue
  alucard continue 174 -C /path/to/target-repo
EOF
}

die() {
  echo "alucard: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

is_uint() {
  [[ "${1:-}" =~ ^[0-9]+$ ]]
}

xml_escape() {
  sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

# Extracts "owner/repo" from a GitHub ref, or returns empty for local paths.
is_github_ref() {
  local input="${1%.git}"  # strip trailing .git before matching
  if [[ "$input" =~ ^git@github\.com:([a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+)$ ]]; then
    echo "${BASH_REMATCH[1]}"
  elif [[ "$input" =~ ^https://github\.com/([a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+)$ ]]; then
    echo "${BASH_REMATCH[1]}"
  elif [[ "$input" =~ ^([a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+)$ ]]; then
    echo "${BASH_REMATCH[1]}"
  fi
}

resolve_repo() {
  local repo="$1"

  # Prefer local path resolution over owner/repo shorthand.
  if [ -d "$repo" ]; then
    git -C "$repo" rev-parse --show-toplevel 2>/dev/null \
      || die "target path is not inside a git repo: $repo"
    return
  fi

  local owner_repo
  owner_repo="$(is_github_ref "$repo")"

  if [ -n "$owner_repo" ]; then
    local cache_path="${DEFAULT_CACHE_DIR}/$owner_repo"
    if [ -d "$cache_path/.git" ]; then
      echo "Refreshing cached clone of $owner_repo..." >&2
      git -C "$cache_path" fetch --quiet origin
    else
      echo "Cloning $owner_repo into $cache_path..." >&2
      mkdir -p "$(dirname "$cache_path")"
      # For explicit SSH URLs, preserve the transport so host SSH keys are used.
      local clone_url
      if [[ "$repo" =~ ^git@github\.com: ]]; then
        clone_url="$repo"
      else
        clone_url="https://github.com/$owner_repo.git"
      fi
      git clone --quiet "$clone_url" "$cache_path"
    fi
    echo "$cache_path"
    return
  fi

  die "target repo does not exist: $repo"
}

load_env_file() {
  local env_file="$1"
  local require="$2"

  if [ ! -f "$env_file" ]; then
    [ "$require" = "false" ] && return 0
    die "missing env file: $env_file"
  fi

  set -a
  # shellcheck disable=SC1090
  source "$env_file"
  set +a
  refresh_agent_settings

  if [ "$require" = "true" ]; then
    [ -n "${GITHUB_TOKEN:-}" ] || die "GITHUB_TOKEN is empty in $env_file"
    if any_role_uses claude; then
      [ -n "${ANTHROPIC_API_KEY:-}" ] || die "ANTHROPIC_API_KEY is empty in $env_file"
    fi
    if any_role_uses codex; then
      [ -n "${OPENAI_API_KEY:-}" ] || die "OPENAI_API_KEY is empty in $env_file"
    fi
  fi
}

# Content hash of the files that define the image.
#
# Content- rather than mtime-based for two reasons: a fresh checkout rewrites
# mtimes and would force a spurious rebuild, and — the blocker — a fully cached
# rebuild leaves Docker's .Created at the *original* layer time, so an mtime
# comparison never converges and rebuilds on every single run.
# $1 = tool dir. Echoes a sha256 hex digest.
build_inputs_hash() {
  local dir="$1" f
  {
    for f in "$dir/Dockerfile" "$dir/entrypoint.sh"; do
      if [ -f "$f" ]; then
        # Name marker so moving content between the two files still changes
        # the digest.
        printf '=== %s\n' "$(basename "$f")"
        cat "$f"
      fi
    done
  } | sha256sum | cut -d' ' -f1
}

BUILD_INPUTS_LABEL="alucard.build-inputs"

# Build the image, stamping it with the hash of its build inputs. The label is
# image config, not a layer, so it updates even when every layer is cached.
build_image() {
  local image="$1" hash="$2"
  docker build --label "${BUILD_INPUTS_LABEL}=${hash}" -t "$image" "$TOOL_DIR"
}

ensure_image() {
  local image="$1"
  local auto_build="$2"

  need_cmd docker

  local want_hash
  want_hash=$(build_inputs_hash "$TOOL_DIR")

  if ! docker image inspect "$image" >/dev/null 2>&1; then
    [ "$auto_build" = "true" ] || die "Docker image not found: $image"
    echo "Building $image from $TOOL_DIR..."
    build_image "$image" "$want_hash"
    return 0
  fi

  # An existing tag is not proof the image is current. A Dockerfile fix — a
  # missing C compiler, say — would otherwise sit inert behind the cached tag
  # on every future run, which is exactly how the toolchain stayed broken for
  # 25 review cycles.
  local have_hash
  have_hash=$(docker image inspect \
    -f "{{index .Config.Labels \"${BUILD_INPUTS_LABEL}\"}}" "$image" 2>/dev/null || true)
  # Go's text/template renders a missing key as "<no value>".
  [ "$have_hash" = "<no value>" ] && have_hash=""

  if [ "$have_hash" = "$want_hash" ]; then
    return 0
  fi

  if [ "$auto_build" != "true" ]; then
    if [ -z "$have_hash" ]; then
      echo "Warning: $image carries no build-input stamp — it predates this check and may be stale." >&2
    else
      echo "Warning: $image was built from different Dockerfile/entrypoint.sh content than $TOOL_DIR holds now." >&2
    fi
    echo "         Rebuild with 'docker build -t $image $TOOL_DIR', or drop --no-build." >&2
    return 0
  fi

  echo "Rebuilding $image — Dockerfile or entrypoint.sh changed since the image was built..."
  build_image "$image" "$want_hash"
}

# Resolves the AI provider for a given agent ROLE.
# Checks ALUCARD_<ROLE>_PROVIDER, falls back to ALUCARD_PROVIDER, then 'claude'.
# Valid values: claude, codex. Exits non-zero on an unrecognized value.
resolve_provider() {
  local role="${1:?resolve_provider requires a ROLE argument}"
  local var="ALUCARD_${role}_PROVIDER"
  local value="${!var:-}"
  local provider="${value:-${ALUCARD_PROVIDER:-claude}}"
  case "$provider" in
    claude|codex) echo "$provider" ;;
    *) die "unrecognized provider '${provider}' for role ${role}: must be 'claude' or 'codex'" ;;
  esac
}

# Returns 0 if any of the four agent roles resolves to PROVIDER, 1 otherwise.
any_role_uses() {
  local provider="${1:?any_role_uses requires a PROVIDER argument}"
  local role resolved
  for role in WORKER CI_FIX REVIEWER FEEDBACK; do
    resolved=$(resolve_provider "$role") || return $?
    [ "$resolved" = "$provider" ] && return 0
  done
  return 1
}

# Run one agent container and stream its output to a log file.
# $1 = role tag (container name becomes alucard-<role>)
# $2 = log file path (JSONL stream written here via tee)
# $3 = --max-turns value (Claude only)
# $4 = --max-budget-usd value (Claude only)
# $5 = prompt text (Claude: passed as -- argument; Codex: fed via stdin)
# $6+ = extra docker args (volumes, env vars specific to this call-site)
# Uses globals: TIMEOUT_MIN ENV_FILE IMAGE stream_text codex_stream_text
# Returns the docker run exit code.
invoke_agent() {
  local role="$1" log_file="$2" max_turns="$3" max_budget="$4" prompt="$5"
  shift 5

  # Map role tag prefix to the symbolic role name resolve_provider expects.
  local provider_role
  case "$role" in
    iter-*)     provider_role="WORKER" ;;
    fix-*)      provider_role="CI_FIX" ;;
    review-*)   provider_role="REVIEWER" ;;
    feedback-*) provider_role="FEEDBACK" ;;
    *)          provider_role="WORKER" ;;
  esac

  local provider
  provider=$(resolve_provider "$provider_role")

  local -a _docker_args=(
    --name "alucard-${role}"
    --network bridge
    --memory 4g --cpus 2
    --read-only
    --tmpfs /tmp:exec,size=2g
    --tmpfs "/home/alucard:size=2g,uid=$(id -u),gid=$(id -g)"
    --ulimit "nofile=8192:8192"
    --user "$(id -u):$(id -g)"
    --security-opt no-new-privileges
    --cap-drop ALL
    --env-file "$ENV_FILE"
    -e "HOME=/home/alucard"
    -e "GIT_CONFIG_GLOBAL=/tmp/alucard-gitconfig"
    -e "GH_CONFIG_DIR=/tmp/gh"
    "$@"
    "$IMAGE"
  )

  # Wedge detector: if /work goes "deleted" in the harness's CWD tracking,
  # every subsequent tool call fails silently and the iteration burns budget
  # thrashing. Kill the container as soon as we see the marker so the wrapper
  # can move on to the next iteration.
  (
    while [ ! -e "$log_file" ]; do sleep 0.2; done
    tail -F "$log_file" 2>/dev/null \
      | grep --line-buffered -m1 -F 'Shell cwd was reset to /work (deleted)' >/dev/null \
      && { echo "alucard: detected /work wedge in alucard-${role} — killing container" >&2; \
           docker kill "alucard-${role}" >/dev/null 2>&1; } || true
  ) &
  local _watcher_pid=$!

  local _rc
  if [ "$provider" = "codex" ]; then
    local codex_model="${ALUCARD_CODEX_MODEL:-gpt-5.6-terra}"
    # Prompt is fed via process substitution so PIPESTATUS[0] captures docker's exit.
    timeout "${TIMEOUT_MIN}m" docker run --rm -i \
      "${_docker_args[@]}" \
      codex exec \
        --dangerously-bypass-approvals-and-sandbox \
        --json \
        --ephemeral \
        -m "$codex_model" \
        - \
      < <(printf '%s' "$prompt") \
      | grep --line-buffered '^{' \
      | tee "$log_file" \
      | jq --unbuffered -rj "$codex_stream_text"
    _rc=${PIPESTATUS[0]}
  else
    timeout "${TIMEOUT_MIN}m" docker run --rm \
      "${_docker_args[@]}" \
      claude -p \
        --verbose \
        --output-format stream-json \
        --include-partial-messages \
        --permission-mode bypassPermissions \
        --max-turns "$max_turns" \
        --max-budget-usd "$max_budget" \
        --model "$DEFAULT_CLAUDE_MODEL" \
        --fallback-model "$DEFAULT_CLAUDE_FALLBACK_MODEL" \
        --disallowedTools "Bash(rm -rf /*),Bash(sudo *),Bash(curl * | sh),Bash(curl * | bash),Bash(wget * | sh),Bash(dd if=*),Bash(mkfs*)" \
        -- \
        "$prompt" \
      | grep --line-buffered '^{' \
      | tee "$log_file" \
      | jq --unbuffered -rj "$stream_text"
    _rc=${PIPESTATUS[0]}
  fi

  # Reap the wedge watcher (and its tail/grep children) whether or not it triggered.
  pkill -P "$_watcher_pid" 2>/dev/null || true
  kill "$_watcher_pid" 2>/dev/null || true
  wait "$_watcher_pid" 2>/dev/null || true

  return "$_rc"
}

parse_repo_options() {
  TARGET_REPO="${ALUCARD_TARGET_REPO:-$PWD}"
  IMAGE="$DEFAULT_IMAGE"
  ENV_FILE="$DEFAULT_ENV_FILE"
  BASE_BRANCH="$DEFAULT_BASE_BRANCH"
  LOG_ROOT="$DEFAULT_LOG_ROOT"
  ITERATIONS=20
  TIMEOUT_MIN=30
  MAX_REVIEW_CYCLES=10
  AUTO_BUILD=true
  TARGET_REPO_SET=false
  TASKS_FILE="${ALUCARD_TASKS_FILE:-}"
  TASKS_FILE_FROM_FLAG=false
  FORCE_GITHUB=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -C|--repo)
        [ -n "${2:-}" ] || die "$1 requires a path"
        TARGET_REPO="$2"
        TARGET_REPO_SET=true
        shift 2
        ;;
      -n|--iterations)
        [ -n "${2:-}" ] || die "$1 requires a number"
        is_uint "$2" || die "iterations must be a positive integer"
        ITERATIONS="$2"
        shift 2
        ;;
      -t|--timeout-minutes)
        [ -n "${2:-}" ] || die "$1 requires a number"
        is_uint "$2" || die "timeout must be a positive integer"
        TIMEOUT_MIN="$2"
        shift 2
        ;;
      --base)
        [ -n "${2:-}" ] || die "$1 requires a branch name"
        BASE_BRANCH="$2"
        shift 2
        ;;
      --env-file)
        [ -n "${2:-}" ] || die "$1 requires a path"
        ENV_FILE="$2"
        shift 2
        ;;
      --image)
        [ -n "${2:-}" ] || die "$1 requires an image name"
        IMAGE="$2"
        shift 2
        ;;
      --logs-root)
        [ -n "${2:-}" ] || die "$1 requires a path"
        LOG_ROOT="$2"
        shift 2
        ;;
      --max-review-cycles)
        [ -n "${2:-}" ] || die "$1 requires a number"
        is_uint "$2" || die "max-review-cycles must be a positive integer"
        MAX_REVIEW_CYCLES="$2"
        shift 2
        ;;
      --no-build)
        AUTO_BUILD=false
        shift
        ;;
      --tasks)
        [ -n "${2:-}" ] || die "$1 requires a path"
        TASKS_FILE="$2"
        TASKS_FILE_FROM_FLAG=true
        shift 2
        ;;
      --github)
        FORCE_GITHUB=true
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --)
        shift
        [ "$#" -eq 0 ] || die "unexpected arguments after --: $*"
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        [ "$TARGET_REPO_SET" = "false" ] || die "unexpected argument: $1"
        TARGET_REPO="$1"
        TARGET_REPO_SET=true
        shift
        ;;
    esac
  done
}

get_unblocked_afk_issues() {
  local repo_abs="$1"
  local all open_prs issue body blockers blocked state skip num has_pr _gh_repo owner repo

  all=$(cd "$repo_abs" && gh issue list --state open --label afk --limit 500 \
        --json number,title,body,labels)

  # Use GitHub's own closing-issue graph so PR detection is never left to LLM
  # output format — GitHub parses the PR body; we just read the result.
  _gh_repo=$(cd "$repo_abs" && gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)
  owner="${_gh_repo%%/*}"
  repo="${_gh_repo#*/}"
  open_prs="[]"
  if [ -n "$owner" ] && [ -n "$repo" ]; then
    open_prs=$(cd "$repo_abs" && gh api graphql \
      -f query='query($owner:String!,$repo:String!){
        repository(owner:$owner,name:$repo){
          pullRequests(states:OPEN,first:100){
            nodes{number,closingIssuesReferences(first:25){nodes{number}}}
          }
        }
      }' \
      -f owner="$owner" -f repo="$repo" \
      --jq '.data.repository.pullRequests.nodes' 2>/dev/null || echo "[]")
  fi

  echo "$all" | jq -c '.[]' | while read -r issue; do
    body=$(echo "$issue" | jq -r '.body // ""')
    blockers=$(echo "$body" | grep -oE 'Blocked by #[0-9]+' \
               | grep -oE '[0-9]+' || true)

    blocked=false
    for b in $blockers; do
      state=$(cd "$repo_abs" && gh issue view "$b" --json state -q .state 2>/dev/null || echo "OPEN")
      [ "$state" = "OPEN" ] && { blocked=true; break; }
    done

    skip=$(echo "$issue" | jq -r '
      .labels | map(.name) | any(. == "in-progress" or . == "wip")')

    # Skip if GitHub's own closing-issue graph links an open PR to this issue.
    if [ "$skip" = "false" ]; then
      num=$(echo "$issue" | jq -r '.number')
      has_pr=$(echo "$open_prs" | jq --argjson n "$num" \
        '[.[] | select((.closingIssuesReferences.nodes // []) | map(.number) | contains([$n]))] | length')
      [ "${has_pr:-0}" -gt 0 ] && skip="true"
    fi

    if [ "$blocked" = false ] && [ "$skip" = "false" ]; then
      echo "$issue"
    fi
  done | jq -s '.'
}

# ── Local task source ─────────────────────────────────────────────────────────
# A tasks file is one markdown file per plan: everything above the first task
# heading is the plan's parent context; each `## [<state>] <id>: <title>`
# section is a task. States: " " queued, ">" PR in flight, "x" done,
# "h" human task (never queued). File order is queue order.

# Parse a tasks file into {parent_context, tasks, errors} without filtering.
# Pure and offline — structure only, no eligibility decisions, no network.
# Each task carries: id, state, title (PR suffix stripped), pr (from a
# trailing "(PR #N)" title suffix, else null), line (heading line number,
# for doctor diagnostics), body (raw markdown until the next task heading).
parse_tasks_file() {
  local file="$1"
  jq -R -s '
    "^## \\[(?<st>[ >xh])\\] (?<id>[A-Za-z0-9_-]+): (?<title>.+)$" as $heading_re
    | gsub("\r"; "")
    | split("\n") as $lines
    | reduce range(0; $lines | length) as $i (
        {header: [], tasks: [], errors: [], cur: null};
        $lines[$i] as $l
        | if ($l | test("^##[[:space:]]*\\[")) then
            ([$l | capture($heading_re)] | .[0]) as $m
            | if $m == null then
                .errors += ["line \($i + 1): malformed task heading: \($l)"]
              else
                .tasks += (if .cur == null then [] else [.cur] end)
                | .cur = {
                    id: $m.id,
                    state: $m.st,
                    title: ($m.title | sub("[[:space:]]*\\(PR #[0-9]+\\)[[:space:]]*$"; "")),
                    pr: ([$m.title | capture("\\(PR #(?<n>[0-9]+)\\)[[:space:]]*$") | .n | tonumber] | .[0]),
                    line: ($i + 1),
                    body_lines: []
                  }
              end
          elif .cur == null then
            .header += [$l]
          else
            .cur.body_lines += [$l]
          end
      )
    | .tasks += (if .cur == null then [] else [.cur] end)
    | {
        parent_context: (.header | join("\n") | sub("\\n+$"; "")),
        errors,
        tasks: [ .tasks[] | {
            id, state, title, pr, line,
            body: (.body_lines | join("\n") | sub("^\\n+"; "") | sub("\\n+$"; ""))
          } ]
      }
  ' < "$file"
}

# Eligible queue from a tasks file: state " " tasks whose blockers are all
# satisfied, in file order. `Blocked by:` task ids must be [x]; GitHub-issue
# blockers ("Blocked by #N", or "#N" tokens in a Blocked by: line) must be
# closed, mirroring the GitHub-mode convention. Unknown task ids block
# conservatively — `alucard doctor` reports them loudly. Dies on parse
# errors: a malformed file should kill the run at launch, not mid-night.
# Emits a JSON array of {id, title, body}.
get_unblocked_local_tasks() {
  local file="$1" repo_abs="$2"
  local parsed errors candidates task ref state blocked

  parsed=$(parse_tasks_file "$file")
  errors=$(echo "$parsed" | jq -r '.errors[]')
  [ -z "$errors" ] || die "invalid tasks file $file:
$errors"

  candidates=$(echo "$parsed" | jq -c '
    (.tasks | map({key: .id, value: .state}) | from_entries) as $states
    | .tasks[]
    | select(.state == " ")
    | (.body | split("\n") | map(select(test("^Blocked by:")))
       | map(sub("^Blocked by:"; "") | [scan("[^,[:space:]]+")])
       | flatten) as $tokens
    | ($tokens | map(select(. != "none" and (startswith("#") | not)))) as $task_blockers
    | (($tokens | map(select(startswith("#")) | ltrimstr("#")))
        + [.body | scan("Blocked by #([0-9]+)") | .[0]]
       | unique) as $issue_blockers
    | select([$task_blockers[] | $states[.] // "?"] | all(. == "x"))
    | {id, title, body, issue_blockers: $issue_blockers}
  ')

  echo "$candidates" | while IFS= read -r task; do
    [ -n "$task" ] || continue

    blocked=false
    for ref in $(echo "$task" | jq -r '.issue_blockers[]'); do
      state=$(cd "$repo_abs" && gh issue view "$ref" --json state -q .state 2>/dev/null || echo "OPEN")
      [ "$state" = "OPEN" ] && { blocked=true; break; }
    done

    if [ "$blocked" = false ]; then
      echo "$task" | jq -c 'del(.issue_blockers)'
    fi
  done | jq -s '.'
}

# Structural validation for doctor: prints one problem per line, returns 1 if
# any. Offline by design — GitHub blocker states are a queue-time concern.
validate_tasks_file() {
  local file="$1" problems
  problems=$(parse_tasks_file "$file" | jq -r '
    (.tasks | map(.id)) as $ids
    | .errors[],
      (.tasks | group_by(.id) | .[] | select(length > 1)
        | "line \(.[-1].line): duplicate task id \(.[0].id) (first used at line \(.[0].line))"),
      (.tasks[] as $t
        | ($t.body | split("\n") | map(select(test("^Blocked by:")))
           | map(sub("^Blocked by:"; "") | [scan("[^,[:space:]]+")])
           | flatten
           | map(select(. != "none" and (startswith("#") | not)))
           | .[]) as $ref
        | select(($ids | index($ref)) == null)
        | "line \($t.line): task \($t.id) blocked by unknown task id \($ref)"),
      (select((.parent_context | gsub("[[:space:]]+"; "") | length) == 0)
        | "line 1: empty header — no parent context above the first task heading"),
      (select((.tasks | length) == 0)
        | "line 1: no task headings found")
  ')
  [ -z "$problems" ] || { printf '%s\n' "$problems"; return 1; }
}

# Local-source in-flight marking: flip the dispatched task's heading from
# "[ ]" to "[>]" and append "(PR #N)" so the queue skips it while the PR is
# open and the reconcile pass can track the outcome. Single-line edit keyed
# on the task id, written atomically. Silent on a missing heading (returns 1)
# — callers own the failure message.
mark_task_in_flight() {
  local file="$1" task_id="$2" pr_num="$3"
  local tmp
  tmp=$(mktemp "${file}.XXXXXX") || return 1
  if awk -v id="$task_id" -v pr="$pr_num" '
    !done && $0 ~ ("^## \\[ \\] " id ": ") {
      sub(/^## \[ \]/, "## [>]")
      $0 = $0 " (PR #" pr ")"
      done = 1
    }
    { print }
    END { exit done ? 0 : 1 }
  ' "$file" > "$tmp"; then
    chmod --reference="$file" "$tmp" 2>/dev/null || true
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
    return 1
  fi
}

# Local analog of GitHub's auto-close-on-merge: before the queue is built,
# check every "[>] <id>: <title> (PR #N)" heading against that PR's actual
# state. Merged flips to "[x]" (the "(PR #N)" suffix stays, as history);
# closed-without-merging flips back to "[ ]" and rewrites the suffix to
# "(previous attempt: PR #N)" so the next dispatch — and the worker prompt's
# "previous attempt" instruction — can find it; open PRs are left alone (the
# task stays skipped, same as today). One `gh pr view` per in-flight heading.
# A `gh` failure (auth, network, rate limit) skips that task's line entirely
# rather than writing a guess — fail safe, never fail dirty. Rewrite is
# atomic (temp file + rename) and touches only the matched heading lines;
# every other byte, including untouched in-flight headings, is preserved.
reconcile_tasks_file() {
  local file="$1" repo_abs="$2"
  local parsed inflight id pr state actions tmp final_newline

  parsed=$(parse_tasks_file "$file") || return 0
  inflight=$(echo "$parsed" | jq -c '.tasks[] | select(.state == ">" and .pr != null) | {id, pr}')
  [ -n "$inflight" ] || return 0

  actions=$(mktemp) || return 1
  : > "$actions"

  while IFS= read -r t; do
    [ -n "$t" ] || continue
    id=$(echo "$t" | jq -r '.id')
    pr=$(echo "$t" | jq -r '.pr')
    state=$(cd "$repo_abs" && gh pr view "$pr" --json state -q .state 2>/dev/null) || continue
    case "$state" in
      MERGED) printf '%s\t%s\tx\n' "$id" "$pr" >> "$actions" ;;
      CLOSED) printf '%s\t%s\t \n' "$id" "$pr" >> "$actions" ;;
      *) : ;; # OPEN (or anything else) — leave the heading alone
    esac
  done <<< "$inflight"

  if [ ! -s "$actions" ]; then
    rm -f "$actions"
    return 0
  fi

  if [ -s "$file" ] && [ "$(tail -c 1 "$file" | od -An -t x1 | tr -d " \n")" = "0a" ]; then
    final_newline=1
  else
    final_newline=0
  fi

  tmp=$(mktemp "${file}.XXXXXX") || { rm -f "$actions"; return 1; }
  if awk -F'\t' -v final_newline="$final_newline" '
    NR == FNR { newstate[$1] = $3; pr[$1] = $2; next }
    {
      if (seen_file_line) {
        printf "%s\n", previous_line
      }
      for (id in newstate) {
        pat = "^## \\[>\\] " id ": .*\\(PR #" pr[id] "\\)[[:space:]]*$"
        if ($0 ~ pat) {
          if (newstate[id] == "x") {
            sub(/^## \[>\]/, "## [x]")
          } else {
            sub(/^## \[>\]/, "## [ ]")
            sub("\\(PR #" pr[id] "\\)[[:space:]]*$", "(previous attempt: PR #" pr[id] ")")
          }
          break
        }
      }
      previous_line = $0
      seen_file_line = 1
    }
    END {
      if (seen_file_line) {
        printf "%s", previous_line
        if (final_newline == 1) {
          printf "\n"
        }
      }
    }
  ' "$actions" "$file" > "$tmp"; then
    rm -f "$actions"
    chmod --reference="$file" "$tmp" 2>/dev/null || true
    mv "$tmp" "$file"
  else
    rm -f "$actions" "$tmp"
    return 1
  fi
}

# Decide where this invocation's tasks come from. Sets TASK_SOURCE
# (github|file) and, for file mode, TASKS_FILE_ABS. Precedence: --github
# beats everything except an explicit --tasks (the combination is an error),
# then --tasks/ALUCARD_TASKS_FILE, then an auto-detected .alucard/tasks.md in
# the target repo, else the GitHub issue queue.
resolve_task_source() {
  local repo_abs="${1:-}"
  TASK_SOURCE="github"
  TASKS_FILE_ABS=""

  if [ "$FORCE_GITHUB" = "true" ]; then
    [ "$TASKS_FILE_FROM_FLAG" = "false" ] || die "--tasks and --github are mutually exclusive"
    return 0
  fi

  if [ -n "$TASKS_FILE" ]; then
    [ -f "$TASKS_FILE" ] || die "tasks file not found: $TASKS_FILE"
    TASKS_FILE_ABS="$(cd "$(dirname "$TASKS_FILE")" && pwd)/$(basename "$TASKS_FILE")"
    TASK_SOURCE="file"
    return 0
  fi

  if [ -n "$repo_abs" ] && [ -f "$repo_abs/.alucard/tasks.md" ]; then
    TASKS_FILE_ABS="$repo_abs/.alucard/tasks.md"
    TASK_SOURCE="file"
  fi
}

# Task-source seam: consumers ask this dispatcher for the eligible queue,
# never a source function directly. A source implements: the eligible queue
# (here), in-flight marking (mark_task_in_flight), state reconciliation
# (reconcile_tasks_file), the PR linkage line ("Closes #N" / "Task: <id>"),
# prior notes, and the usage-report destination — everything else is
# source-blind.
get_task_queue() {
  local repo_abs="$1"
  case "$TASK_SOURCE" in
    file)   reconcile_tasks_file "$TASKS_FILE_ABS" "$repo_abs"
            get_unblocked_local_tasks "$TASKS_FILE_ABS" "$repo_abs" ;;
    github) get_unblocked_afk_issues "$repo_abs" ;;
    *)      die "unknown task source: ${TASK_SOURCE:-unset}" ;;
  esac
}

print_usage_report() {
  local log_dir="$1"

  [ -d "$log_dir" ] || return 0

  local -a labels=() inps=() outs=() crs=() cws=() turnss=() costs=()
  local f base label mid
  local total_inp=0 total_out=0 total_cr=0 total_cw=0 total_turns=0
  local total_cost="0"

  while IFS= read -r f; do
    base=$(basename "$f" .jsonl)
    case "$base" in
      iter-*-fix-*)
        mid="${base#iter-}"; label="ci-fix ${mid/-fix-/.}" ;;
      iter-*-review-*)
        mid="${base#iter-}"; label="review ${mid/-review-/.}" ;;
      iter-*-feedback-*)
        mid="${base#iter-}"; label="feedback ${mid/-feedback-/.}" ;;
      iter-*)
        label="worker ${base#iter-}" ;;
      *)
        label="$base" ;;
    esac

    local inp out cr cw turns cost
    # read returns non-zero on empty input; guard with || true so set -e doesn't
    # abort the report when a log has no result line (timeout, Ctrl+C, etc.)
    IFS=$'\t' read -r inp out cr cw turns cost < <(
      tail -n 20 "$f" | grep '"type":"result"' | tail -1 \
        | jq -r 'select(.type == "result") |
            ([ .modelUsage // {} | to_entries[] | .value ] as $m |
            [
              ([$m[].inputTokens            // 0] | add // 0),
              ([$m[].outputTokens           // 0] | add // 0),
              ([$m[].cacheReadInputTokens   // 0] | add // 0),
              ([$m[].cacheCreationInputTokens // 0] | add // 0),
              (.num_turns // 0),
              (.total_cost_usd // 0)
            ]) | @tsv' 2>/dev/null || true
    ) || true

    [ -z "${inp:-}" ] && continue

    labels+=("$label")
    inps+=("$inp")
    outs+=("$out")
    crs+=("$cr")
    cws+=("$cw")
    turnss+=("$turns")
    costs+=("$cost")

    total_inp=$((total_inp + inp))
    total_out=$((total_out + out))
    total_cr=$((total_cr + cr))
    total_cw=$((total_cw + cw))
    total_turns=$((total_turns + turns))
    total_cost=$(awk "BEGIN { printf \"%.4f\", $total_cost + $cost }")
  done < <(find "$log_dir" -maxdepth 1 -name '*.jsonl' 2>/dev/null | sort -V)

  [ "${#labels[@]}" -eq 0 ] && return 0

  local sep
  sep=$(printf '%86s' '' | tr ' ' '-')

  printf '\n=== Alucard Token Usage: %s ===\n' "$(basename "$log_dir")"
  printf '%-22s  %10s  %8s  %12s  %12s  %5s  %8s\n' \
    "Agent" "Input" "Output" "Cache Read" "Cache Write" "Turns" "Cost"
  printf '%s\n' "$sep"

  local i
  for i in "${!labels[@]}"; do
    printf '%-22s  %10s  %8s  %12s  %12s  %5s  %8s\n' \
      "${labels[$i]}" "${inps[$i]}" "${outs[$i]}" "${crs[$i]}" "${cws[$i]}" \
      "${turnss[$i]}" "$(printf '$%.3f' "${costs[$i]}")"
  done

  printf '%s\n' "$sep"
  printf '%-22s  %10s  %8s  %12s  %12s  %5s  %8s\n' \
    "TOTAL" "$total_inp" "$total_out" "$total_cr" "$total_cw" "$total_turns" \
    "$(printf '$%.3f' "$total_cost")"
  printf '\n'
}

# Post a collapsible markdown token-usage table to the GitHub issue closed by
# this iteration's PR.
# $1 = iteration index, $2 = branch, $3 = repo abs path, $4 = log dir
post_iteration_usage() {
  local iter="$1" branch="$2" repo_abs="$3" log_dir="$4"

  local pr_num
  pr_num=$(cd "$repo_abs" && \
    gh pr list --head "$branch" --state all --json number \
      --jq '.[0].number // empty' 2>/dev/null || true)
  [ -n "${pr_num:-}" ] || return 0

  # Local-source PRs carry "Task: <id>" instead of a closing keyword — no
  # issue to comment on, so the table falls back to the PR itself below.
  local issue_num
  issue_num=$(cd "$repo_abs" && \
    gh pr view "$pr_num" --json body --jq '.body' 2>/dev/null \
    | grep -oiE '(closes|fixes|resolves)[[:space:]]+#[0-9]+' \
    | grep -oE '[0-9]+' | head -1 || true)

  local -a rows=()
  local total_inp=0 total_out=0 total_cr=0 total_cw=0 total_turns=0
  local total_cost="0"
  local f base label mid inp out cr cw turns cost

  while IFS= read -r f; do
    base=$(basename "$f" .jsonl)
    case "$base" in
      iter-${iter}-fix-*)
        mid="${base#iter-}"; label="ci-fix ${mid/-fix-/.}" ;;
      iter-${iter}-review-*)
        mid="${base#iter-}"; label="review ${mid/-review-/.}" ;;
      iter-${iter}-feedback-*)
        mid="${base#iter-}"; label="feedback ${mid/-feedback-/.}" ;;
      iter-${iter})
        label="worker $iter" ;;
      *)
        continue ;;
    esac

    IFS=$'\t' read -r inp out cr cw turns cost < <(
      tail -n 20 "$f" | grep '"type":"result"' | tail -1 \
        | jq -r 'select(.type == "result") |
            ([ .modelUsage // {} | to_entries[] | .value ] as $m |
            [
              ([$m[].inputTokens              // 0] | add // 0),
              ([$m[].outputTokens             // 0] | add // 0),
              ([$m[].cacheReadInputTokens     // 0] | add // 0),
              ([$m[].cacheCreationInputTokens // 0] | add // 0),
              (.num_turns // 0),
              (.total_cost_usd // 0)
            ]) | @tsv' 2>/dev/null || true
    ) || true

    [ -z "${inp:-}" ] && continue

    rows+=("| ${label} | ${inp} | ${out} | ${cr} | ${cw} | ${turns} | \$$(printf '%.3f' "${cost}") |")
    total_inp=$((total_inp + inp))
    total_out=$((total_out + out))
    total_cr=$((total_cr + cr))
    total_cw=$((total_cw + cw))
    total_turns=$((total_turns + turns))
    total_cost=$(awk "BEGIN { printf \"%.4f\", $total_cost + $cost }")
  done < <(
    { find "$log_dir" -maxdepth 1 -name "iter-${iter}.jsonl" 2>/dev/null
      find "$log_dir" -maxdepth 1 -name "iter-${iter}-*.jsonl" 2>/dev/null
    } | sort -V
  )

  [ "${#rows[@]}" -eq 0 ] && return 0

  local body
  body="<details><summary>🤖 Alucard token usage (iteration ${iter})</summary>

| Agent | Input | Output | Cache Read | Cache Write | Turns | Cost |
|-------|------:|-------:|-----------:|------------:|------:|-----:|
$(printf '%s\n' "${rows[@]}")
| **TOTAL** | **${total_inp}** | **${total_out}** | **${total_cr}** | **${total_cw}** | **${total_turns}** | **\$$(printf '%.3f' "${total_cost}")** |

</details>"

  if [ -n "${issue_num:-}" ]; then
    echo "Posting token usage to issue #${issue_num}..."
    cd "$repo_abs" && gh issue comment "$issue_num" --body "$body" 2>/dev/null || true
  else
    echo "Posting token usage to PR #${pr_num}..."
    cd "$repo_abs" && gh pr comment "$pr_num" --body "$body" 2>/dev/null || true
  fi
}

command_build() {
  IMAGE="$DEFAULT_IMAGE"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --image)
        [ -n "${2:-}" ] || die "$1 requires an image name"
        IMAGE="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown build option: $1"
        ;;
    esac
  done

  need_cmd docker
  docker build -t "$IMAGE" "$TOOL_DIR"
}

command_version() {
  local ver
  ver=$(git -C "$TOOL_DIR" describe --tags --always --dirty 2>/dev/null) || ver="unknown"
  echo "$ver"
}

command_queue() {
  parse_repo_options "$@"
  need_cmd git
  need_cmd gh
  need_cmd jq

  REPO_ABS=$(resolve_repo "$TARGET_REPO")
  load_env_file "$ENV_FILE" false
  resolve_task_source "$REPO_ABS"
  get_task_queue "$REPO_ABS"
}

command_doctor() {
  parse_repo_options "$@"

  local ok=true
  for cmd in git gh jq docker timeout; do
    if command -v "$cmd" >/dev/null 2>&1; then
      echo "ok: $cmd"
    else
      echo "missing: $cmd"
      ok=false
    fi
  done

  local _missing_files=false
  for _f in Dockerfile entrypoint.sh \
             alucard-worker-prompt.md alucard-reviewer-prompt.md \
             alucard-ci-fix-prompt.md alucard-feedback-prompt.md; do
    if [ ! -f "$TOOL_DIR/$_f" ]; then
      echo "missing: $TOOL_DIR/$_f"
      _missing_files=true
    fi
  done
  if [ "$_missing_files" = "false" ]; then
    echo "ok: tool files in $TOOL_DIR"
  else
    ok=false
  fi

  if [ -f "$ENV_FILE" ]; then
    echo "ok: env file $ENV_FILE"
    load_env_file "$ENV_FILE" false
    [ -n "${GITHUB_TOKEN:-}" ] || { echo "missing: GITHUB_TOKEN value"; ok=false; }
    if any_role_uses claude; then
      if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
        echo "ok: ANTHROPIC_API_KEY"
      else
        echo "missing: ANTHROPIC_API_KEY value"; ok=false
      fi
    fi
    if any_role_uses codex; then
      if [ -n "${OPENAI_API_KEY:-}" ]; then
        echo "ok: OPENAI_API_KEY"
      else
        echo "missing: OPENAI_API_KEY value"; ok=false
      fi
    fi
  else
    echo "missing: env file $ENV_FILE"
    ok=false
  fi

  local _owner_repo
  if [ -d "$TARGET_REPO" ] && REPO_ABS=$(git -C "$TARGET_REPO" rev-parse --show-toplevel 2>/dev/null); then
    echo "ok: target repo $REPO_ABS"
    if git -C "$REPO_ABS" config --get remote.origin.url >/dev/null; then
      echo "ok: target repo has origin remote"
    else
      echo "missing: target repo origin remote"
      ok=false
    fi
  elif _owner_repo="$(is_github_ref "$TARGET_REPO")" && [ -n "$_owner_repo" ]; then
    if gh repo view "$_owner_repo" --json name >/dev/null 2>&1; then
      echo "ok: target repo is GitHub ref $_owner_repo (cache: ${DEFAULT_CACHE_DIR}/$_owner_repo)"
    else
      echo "missing: cannot reach GitHub repo $_owner_repo (check GITHUB_TOKEN and network)"
      ok=false
    fi
  else
    echo "missing: valid target git repo at $TARGET_REPO (or a GitHub ref like owner/repo)"
    ok=false
  fi

  if docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "ok: Docker image $IMAGE"
  else
    echo "missing: Docker image $IMAGE (run: docker pull ghcr.io/aldovc/alucard:latest, or alucard build for a local image)"
  fi

  resolve_task_source "${REPO_ABS:-}"
  if [ "$TASK_SOURCE" = "file" ]; then
    if ! command -v jq >/dev/null 2>&1; then
      echo "skipped: tasks file validation ($TASKS_FILE_ABS) — jq missing"
    else
      local _tasks_problems _todo
      if _tasks_problems=$(validate_tasks_file "$TASKS_FILE_ABS"); then
        _todo=$(parse_tasks_file "$TASKS_FILE_ABS" \
          | jq '[.tasks[] | select(.state == " ")] | length')
        echo "ok: tasks file $TASKS_FILE_ABS (local task source, ${_todo} todo)"
      else
        echo "invalid: tasks file $TASKS_FILE_ABS"
        printf '%s\n' "$_tasks_problems" | sed 's/^/  - /'
        ok=false
      fi
    fi
  fi

  [ "$ok" = "true" ] || exit 1
}

# Run one feedback container against the PR's head branch.
# $1=iter $2=branch $3=origin_url $4=pr_num $5=feedback_findings $6=cycle
# Sets: FEEDBACK_BLOCKED — findings the agent could not resolve in-container
#       (missing credentials/tooling). Empty when everything was actionable.
# Uses globals: WT_ROOT REPO_ABS LOG_DIR TIMEOUT_MIN ENV_FILE IMAGE TOOL_DIR
#               CREATED_WORKTREES stream_text
run_feedback_once() {
  local iter="$1" branch="$2" origin_url="$3" pr_num="$4" feedback_findings="$5" cycle="$6"
  local wt_feedback feedback_log feedback_rc

  FEEDBACK_BLOCKED=""

  wt_feedback="${WT_ROOT}/feedback-${iter}-${cycle}"
  local feedback_out_dir
  feedback_out_dir=$(mktemp -d /tmp/alucard_feedback.XXXXXX)
  CREATED_WORKTREES+=("$wt_feedback" "$feedback_out_dir")
  rm -rf "$wt_feedback"
  git -C "$REPO_ABS" fetch origin "$branch"
  git -C "$REPO_ABS" branch --force "$branch" "origin/$branch"
  git clone --local --no-tags --single-branch --branch "$branch" "$REPO_ABS" "$wt_feedback"
  git -C "$wt_feedback" remote set-url origin "$origin_url"

  feedback_log="$LOG_DIR/iter-${iter}-feedback-${cycle}.jsonl"

  local _feedback_prompt
  _feedback_prompt="<instructions>
$(<"$TOOL_DIR/alucard-feedback-prompt.md")
</instructions>
<pr_num>${pr_num}</pr_num>
<branch>${branch}</branch>
<review_findings>
$(printf '%s' "$feedback_findings" | xml_escape)
</review_findings>"

  set +e
  invoke_agent \
    "feedback-${iter}-${cycle}" \
    "$feedback_log" \
    "$DEFAULT_FEEDBACK_MAX_TURNS" "$DEFAULT_FEEDBACK_MAX_BUDGET" \
    "$_feedback_prompt" \
    -v "$wt_feedback:/work:rw" \
    -v "$feedback_out_dir:/work-output:rw" \
    -e "ALUCARD_ITER=${iter}-feedback-${cycle}"
  feedback_rc=$?
  set -e

  echo ""

  if [ -f "$feedback_out_dir/.alucard-blocked" ]; then
    FEEDBACK_BLOCKED=$(< "$feedback_out_dir/.alucard-blocked")
  fi

  rm -rf "$wt_feedback" "$feedback_out_dir" || true

  if [ "$feedback_rc" -ne 0 ]; then
    echo "Feedback agent exited rc=$feedback_rc on cycle $cycle"
  fi
}

# Run a fresh fix agent on the branch if CI fails after a PR is opened.
# $1 = iteration index, $2 = branch name, $3 = origin HTTPS URL
# Uses globals: REPO_ABS WT_ROOT LOG_DIR TIMEOUT_MIN ENV_FILE IMAGE TOOL_DIR
#               CREATED_WORKTREES stream_text
ci_gate() {
  local iter="$1" branch="$2" origin_url="$3"

  local pr_num
  pr_num=$(cd "$REPO_ABS" && \
    gh pr list --head "$branch" --state open --json number \
      --jq '.[0].number // empty' 2>/dev/null || true)

  [ -n "${pr_num:-}" ] || return 0

  echo "=== CI gate: PR #$pr_num on $branch ==="

  local ci_attempt ci_rc failed_run_id failure_log wt_fix fix_log fix_rc _ci_err_file _ci_err pr_head_sha
  for ci_attempt in 1 2 3; do
    # Refresh each attempt so a fix-agent push moves to the new HEAD SHA.
    pr_head_sha=$(cd "$REPO_ABS" && \
      gh pr view "$pr_num" --json headRefOid --jq '.headRefOid' 2>/dev/null || true)
    echo "Polling CI (attempt $ci_attempt/3)..."
    _ci_err_file="$(mktemp /tmp/alucard_ci_err.XXXXXX)"
    set +e
    (cd "$REPO_ABS" && timeout 2700 gh pr checks "$pr_num" --watch --interval 30) \
      2>"$_ci_err_file"
    ci_rc=$?
    _ci_err="$(cat "$_ci_err_file" 2>/dev/null || true)"
    rm -f "$_ci_err_file"
    [ -n "$_ci_err" ] && echo "$_ci_err" >&2
    set -e

    # No CI workflows configured (or none triggered for this PR's changed
    # paths) — treat as a pass. Without this, `gh pr checks --watch` exits 1
    # with "no checks reported", which falls through to the fix-agent loop
    # and burns budget trying to repair CI that does not exist.
    if [ "$ci_rc" -ne 0 ] && echo "$_ci_err" | grep -q "no checks reported"; then
      echo "No checks configured for PR #$pr_num — skipping CI gate."
      ci_rc=0
    fi

    # Token lacks 'checks' read permission — fall back to polling gh run list.
    if [ "$ci_rc" -ne 0 ] && echo "$_ci_err" | grep -q "Resource not accessible"; then
      echo "Token lacks 'checks' read permission — falling back to gh run list for PR #$pr_num..."
      local deadline=$(( $(date +%s) + 2700 ))
      ci_rc=1
      local _found_runs=false
      while [ "$(date +%s)" -lt "$deadline" ]; do
        local run_json
        run_json=$(cd "$REPO_ABS" && \
          gh run list --branch "$branch" --json status,conclusion,databaseId,headSha \
            --jq '[.[] | select(.status != "queued")]' 2>/dev/null || echo "[]")
        if [ -n "${pr_head_sha:-}" ]; then
          run_json=$(echo "$run_json" | jq --arg sha "$pr_head_sha" '[.[] | select(.headSha == $sha)]')
        fi
        local total in_progress failed
        total=$(echo "$run_json" | jq 'length')
        in_progress=$(echo "$run_json" | jq '[.[] | select(.status != "completed")] | length')
        failed=$(echo "$run_json" | jq '[.[] | select(.conclusion == "failure" or .conclusion == "timed_out")] | length')
        if [ "$total" -eq 0 ]; then
          echo "No workflow runs found yet — waiting..."
          sleep 30; continue
        fi
        _found_runs=true
        if [ "$in_progress" -gt 0 ]; then
          echo "Runs still in progress ($in_progress/$total) — waiting..."
          sleep 30; continue
        fi
        if [ "$failed" -gt 0 ]; then
          ci_rc=1
        else
          ci_rc=0
        fi
        break
      done
      # No runs appeared during the entire polling window — token likely also
      # lacks 'actions' read permission. Skip rather than fire spurious fix agents.
      if [ "$_found_runs" = "false" ]; then
        echo "No CI runs visible for PR #$pr_num (token may lack 'actions' read permission) — skipping CI gate."
        ci_rc=0
      fi
    fi

    if [ "$ci_rc" -eq 0 ]; then
      echo "CI green — PR #$pr_num ready for review."
      return 0
    fi

    if [ "$ci_attempt" -eq 3 ]; then
      echo "CI still failing after 3 fix attempts — PR #$pr_num left open for manual review."
      return 0
    fi

    echo "CI failed (attempt $ci_attempt) — launching fix agent..."

    failed_run_id=$(cd "$REPO_ABS" && \
      gh run list --branch "$branch" --json databaseId,conclusion,headSha \
        --jq --arg sha "${pr_head_sha:-}" \
        '[.[] | select(.conclusion=="failure" and ($sha == "" or .headSha == $sha))] | .[0].databaseId // empty' \
        2>/dev/null || true)
    failure_log=""
    if [ -n "${failed_run_id:-}" ]; then
      failure_log=$(cd "$REPO_ABS" && \
        gh run view "$failed_run_id" --log-failed 2>/dev/null | head -400 || true)
    fi

    wt_fix="${WT_ROOT}/fix-${iter}-${ci_attempt}"
    CREATED_WORKTREES+=("$wt_fix")
    rm -rf "$wt_fix"
    git -C "$REPO_ABS" fetch origin "$branch"
    # fetch only creates origin/$branch; create a local branch so --local clone can find it
    git -C "$REPO_ABS" branch --force "$branch" "origin/$branch"
    git clone --local --no-tags --single-branch --branch "$branch" "$REPO_ABS" "$wt_fix"
    git -C "$wt_fix" remote set-url origin "$origin_url"

    fix_log="$LOG_DIR/iter-${iter}-fix-${ci_attempt}.jsonl"

    local _fix_prompt
    _fix_prompt="<instructions>
$(<"$TOOL_DIR/alucard-ci-fix-prompt.md")
</instructions>
<pr_num>${pr_num}</pr_num>
<branch>${branch}</branch>
<failure_log>
$(printf '%s' "$failure_log" | xml_escape)
</failure_log>"

    set +e
    invoke_agent \
      "fix-${iter}-${ci_attempt}" \
      "$fix_log" \
      "$DEFAULT_CI_FIX_MAX_TURNS" "$DEFAULT_CI_FIX_MAX_BUDGET" \
      "$_fix_prompt" \
      -v "$wt_fix:/work:rw" \
      -e "ALUCARD_ITER=${iter}-fix-${ci_attempt}"
    fix_rc=$?
    set -e

    echo ""
    rm -rf "$wt_fix" || true

    if [ "$fix_rc" -ne 0 ]; then
      echo "Fix agent exited rc=$fix_rc on attempt $ci_attempt"
    fi
  done
}

# Appends <task>/<parent_context> to a reviewer prompt when local-mode task
# context is available (task_xml non-empty); a no-op in github mode, where
# the reviewer prompt's own fallback instructs it to `gh issue view` instead.
append_task_context() {
  local prompt="$1" task_xml="$2" parent_xml="$3"
  if [ -n "$task_xml" ]; then
    printf '%s\n<task>%s</task>\n<parent_context>%s</parent_context>' \
      "$prompt" "$task_xml" "$parent_xml"
  else
    printf '%s' "$prompt"
  fi
}

# Reconcile the formal GitHub review state with the reviewer's decision file.
#
# BLOCKED has no GitHub equivalent — a reviewer that reaches it can only post
# `--request-changes` formally — so the decision file wins for that one verdict.
# Otherwise a formal review outranks the file, and the file is the fallback for
# the common case where GitHub refused the review because the bot is also the
# PR author.
#
# $1 = formal state (may be empty), $2 = decision-file state (may be empty)
# Echoes the effective verdict; returns 1 when neither source yields one.
resolve_review_verdict() {
  local formal="$1" file_state="$2"
  if [ "$file_state" = "BLOCKED" ]; then
    printf 'BLOCKED'
    return 0
  fi
  if [ -n "$formal" ]; then
    printf '%s' "$formal"
    return 0
  fi
  case "$file_state" in
    APPROVED|CHANGES_REQUESTED) printf '%s' "$file_state" ;;
    *) return 1 ;;
  esac
}

# Run reviewer then feedback agents on the open PR, up to MAX_REVIEW_CYCLES times.
# $1 = iteration index, $2 = branch name, $3 = origin HTTPS URL
# $4 = task XML (file mode only, empty in github mode)
# $5 = parent context XML (file mode only, empty in github mode)
# Uses globals: REPO_ABS WT_ROOT LOG_DIR TIMEOUT_MIN ENV_FILE IMAGE TOOL_DIR
#               CREATED_WORKTREES stream_text MAX_REVIEW_CYCLES
review_gate() {
  local iter="$1" branch="$2" origin_url="$3"
  local task_xml="${4:-}" parent_context_xml="${5:-}"

  local pr_num
  pr_num=$(cd "$REPO_ABS" && \
    gh pr list --head "$branch" --state open --json number \
      --jq '.[0].number // empty' 2>/dev/null || true)

  [ -n "${pr_num:-}" ] || return 0

  echo "=== Review gate: PR #$pr_num on $branch ==="

  local review_cycle wt_review review_log review_rc review_state review_comments

  # Blocked-findings ledger. Seeded from marker comments already on the PR so a
  # re-run does not spend its whole budget rediscovering what a previous run
  # already established was unfixable in-container.
  local blocked_ledger
  blocked_ledger=$(cd "$REPO_ABS" && \
    gh pr view "$pr_num" --json comments --jq \
      '[.comments[] | select(.body | startswith("**🤖 Alucard blocked findings**")) | .body] | join("\n\n")' \
    2>/dev/null || true)
  if [ -n "$blocked_ledger" ]; then
    echo "Loaded blocked-findings ledger from PR #$pr_num."
  fi

  for review_cycle in $(seq 1 "$MAX_REVIEW_CYCLES"); do
    echo "Review cycle $review_cycle/$MAX_REVIEW_CYCLES — running reviewer agent..."

    wt_review="${WT_ROOT}/review-${iter}-${review_cycle}"
    local review_out_dir
    review_out_dir=$(mktemp -d /tmp/alucard_review.XXXXXX)
    CREATED_WORKTREES+=("$wt_review" "$review_out_dir")
    rm -rf "$wt_review"
    git -C "$REPO_ABS" fetch origin "$branch"
    git -C "$REPO_ABS" branch --force "$branch" "origin/$branch"
    git clone --local --no-tags --single-branch --branch "$branch" "$REPO_ABS" "$wt_review"
    git -C "$wt_review" remote set-url origin "$origin_url"

    review_log="$LOG_DIR/iter-${iter}-review-${review_cycle}.jsonl"

    local _review_prompt
    _review_prompt="<instructions>
$(<"$TOOL_DIR/alucard-reviewer-prompt.md")
</instructions>
<pr_num>${pr_num}</pr_num>
<review_cycle>${review_cycle} of ${MAX_REVIEW_CYCLES}</review_cycle>
<toolchain_status>
$(printf '%s' "${TOOLCHAIN_STATUS:-Unknown — no preflight result available.}" | xml_escape)
</toolchain_status>
<known_blockers>
$(printf '%s' "${blocked_ledger:-None recorded.}" | xml_escape)
</known_blockers>"
    _review_prompt=$(append_task_context "$_review_prompt" "$task_xml" "$parent_context_xml")

    set +e
    invoke_agent \
      "review-${iter}-${review_cycle}" \
      "$review_log" \
      "$DEFAULT_REVIEWER_MAX_TURNS" "$DEFAULT_REVIEWER_MAX_BUDGET" \
      "$_review_prompt" \
      -v "$wt_review:/work:ro" \
      -v "$review_out_dir:/work-output:rw" \
      -e "ALUCARD_ITER=${iter}-review-${review_cycle}"
    review_rc=$?
    set -e

    echo ""

    # Read reviewer output files (written to the separate rw output dir).
    local _review_file_state="" _review_file_body=""
    if [ -f "$review_out_dir/.alucard-review" ]; then
      _review_file_state=$(tr -d '[:space:]' < "$review_out_dir/.alucard-review")
    fi
    if [ -f "$review_out_dir/.alucard-review-body" ]; then
      _review_file_body=$(< "$review_out_dir/.alucard-review-body")
    fi

    rm -rf "$wt_review" "$review_out_dir" || true

    review_state=$(cd "$REPO_ABS" && \
      gh pr view "$pr_num" --json reviews \
        --jq '[.reviews[] | select(.state == "APPROVED" or .state == "CHANGES_REQUESTED")] | last | .state // empty' \
      2>/dev/null || true)

    review_comments=$(cd "$REPO_ABS" && \
      gh pr view "$pr_num" --json reviews \
        --jq '[.reviews[] | select(.state == "APPROVED" or .state == "CHANGES_REQUESTED")] | last | .body // ""' \
      2>/dev/null || true)

    # GitHub blocks formal self-review when the bot token == the PR author,
    # so most runs land here with no formal review on the PR. Trust the
    # reviewer's decision files — see resolve_review_verdict for the precedence
    # rules, including BLOCKED, which GitHub cannot express at all. The earlier
    # concern that file-APPROVED "silently skips the feedback loop" is moot:
    # skipping feedback is exactly the correct behavior for APPROVED, and
    # dropping the verdict entirely (the previous behavior) hid the reviewer's
    # reasoning from the operator without making the loop any safer. The real
    # mitigation for self-approval is the two-token reviewer identity tracked
    # as deferred item #5 in README.md.
    local _formal_state="$review_state" _self_review_note=""
    review_state=$(resolve_review_verdict "$_formal_state" "$_review_file_state" || true)

    if [ -n "$review_state" ] && [ "$review_state" != "$_formal_state" ]; then
      # The verdict came from the decision file rather than a formal review.
      review_comments="$_review_file_body"
      if [ -z "$_formal_state" ]; then
        _self_review_note="

_(Self-review: GitHub blocked a formal \`gh pr review\` because the bot is also the PR author. Verdict and body come from the reviewer agent's decision file.)_"
      else
        _self_review_note="

_(Verdict \`${review_state}\` comes from the reviewer agent's decision file — GitHub has no such review state, so the formal review reads \`${_formal_state}\`.)_"
      fi
      echo "Using reviewer decision file: $review_state"
    fi

    if [ "$review_state" = "APPROVED" ]; then
      echo "PR #$pr_num approved — ready to merge."
      cd "$REPO_ABS" && gh pr comment "$pr_num" --body \
        "**🤖 Alucard review cycle ${review_cycle}/${MAX_REVIEW_CYCLES}: APPROVED**

${review_comments}${_self_review_note}" 2>/dev/null || true
      return 0
    fi

    # Convergence exit. Without this the loop has only two ends — APPROVED or
    # cycle exhaustion — so a finding no agent can act on (missing CLI, missing
    # credentials, a human-only acceptance criterion) is re-reported until the
    # budget runs out, and the feedback agent drifts into unrelated code
    # looking for something it *can* change.
    if [ "$review_state" = "BLOCKED" ]; then
      echo "PR #$pr_num is blocked on human action — ending the review loop at cycle $review_cycle."
      cd "$REPO_ABS" && gh pr comment "$pr_num" --body \
        "**🤖 Alucard review cycle ${review_cycle}/${MAX_REVIEW_CYCLES}: BLOCKED — needs human**

The remaining merge-blocking work cannot be done inside the harness container. Alucard stopped the review loop here rather than spend the remaining $((MAX_REVIEW_CYCLES - review_cycle)) cycle(s) re-reporting it.

${review_comments}${_self_review_note}" 2>/dev/null || true
      cd "$REPO_ABS" && gh pr edit "$pr_num" --add-label "needs-human" 2>/dev/null || true
      return 0
    fi

    if [ -z "$review_state" ]; then
      echo "Reviewer did not post a review (rc=$review_rc) — skipping review gate."
      cd "$REPO_ABS" && gh pr comment "$pr_num" --body \
        "**🤖 Alucard review cycle ${review_cycle}/${MAX_REVIEW_CYCLES}: no review posted** (rc=${review_rc})" \
        2>/dev/null || true
      return 0
    fi

    # CHANGES_REQUESTED path — post findings for audit before acting on them
    cd "$REPO_ABS" && gh pr comment "$pr_num" --body \
      "**🤖 Alucard review cycle ${review_cycle}/${MAX_REVIEW_CYCLES}: CHANGES_REQUESTED**

${review_comments}${_self_review_note}" 2>/dev/null || true

    # Exhaustion is a distinct outcome from "still working", and the operator
    # reads it on the PR, not in a log they were asleep for. Without this the
    # final comment is an ordinary cycle-N CHANGES_REQUESTED and the PR looks
    # identical whether the loop gave up or is still mid-flight.
    if [ "$review_cycle" -eq "$MAX_REVIEW_CYCLES" ]; then
      echo "Max review cycles ($MAX_REVIEW_CYCLES) reached — PR #$pr_num left open for manual review."
      cd "$REPO_ABS" && gh pr comment "$pr_num" --body \
        "**🤖 Alucard gave up after ${MAX_REVIEW_CYCLES}/${MAX_REVIEW_CYCLES} review cycles — needs human**

The reviewer still wants changes and the cycle budget is spent, so no feedback agent ran for the findings above. Nothing further is queued for this PR.

If the same finding has been repeating, it is probably one no agent in this loop can act on — the reviewer should have returned BLOCKED, and the prompt may need sharpening. If the findings kept changing, raise \`--max-review-cycles\` or land what is here and open follow-ups." 2>/dev/null || true
      cd "$REPO_ABS" && gh pr edit "$pr_num" --add-label "needs-human" 2>/dev/null || true
      return 0
    fi

    echo "Changes requested — launching feedback agent (cycle $review_cycle)..."

    # Augment reviewer findings with human-authored PR comments so the
    # feedback agent sees the user's questions/asks alongside the reviewer's
    # findings. Note: alucard runs under a human PAT, so author-based filtering
    # would also drop legitimate human comments. Instead, filter by body prefix
    # — all wrapper-posted comments start with "**🤖 Alucard …**". Reviewer
    # prompt no longer falls back to `gh pr comment`, so this prefix uniquely
    # identifies bot-self comments going forward.
    local human_comments feedback_findings
    human_comments=$(cd "$REPO_ABS" && \
      gh pr view "$pr_num" --json comments --jq '.comments' 2>/dev/null \
      | jq -r '[.[] | select(.body | startswith("**🤖 Alucard") | not) | "- @\(.author.login) at \(.createdAt):\n\(.body)"] | join("\n\n")' \
      2>/dev/null || true)
    feedback_findings="$review_comments"
    if [ -n "$human_comments" ]; then
      feedback_findings="${feedback_findings}

---

## Additional human PR comments

Treat each as an additional finding when actionable and on-topic. Off-topic or out-of-scope comments should be acknowledged via \`gh pr comment --body-file <file>\` rather than silently ignored.

${human_comments}"
    fi

    run_feedback_once "$iter" "$branch" "$origin_url" "$pr_num" "$feedback_findings" "$review_cycle"

    # Record what the feedback agent could not act on, so the next reviewer is
    # told not to re-report it instead of rediscovering it every cycle. Posted
    # as a marker comment, which is also how a later run reloads the ledger.
    if [ -n "${FEEDBACK_BLOCKED:-}" ]; then
      local _blocked_body
      _blocked_body="**🤖 Alucard blocked findings** (cycle ${review_cycle}/${MAX_REVIEW_CYCLES})

The feedback agent could not resolve these inside the harness container. Later review cycles are instructed to treat them as known blockers and not re-report them.

${FEEDBACK_BLOCKED}"
      echo "Feedback agent reported blocked findings — recording on PR #$pr_num."
      cd "$REPO_ABS" && gh pr comment "$pr_num" --body "$_blocked_body" 2>/dev/null || true
      blocked_ledger="${blocked_ledger}

${_blocked_body}"
    fi

    # Re-check CI before the next reviewer sees the updated branch.
    ci_gate "$iter" "$branch" "$origin_url"
  done
}

# Detect how to install the target repo's dependencies. Checks the repo root
# first, then exactly one level down — a backend/ or server/ subdir owning the
# manifest is the common layout in these repos.
# $1 = repo root. Echoes "<install_cmd><TAB><dir>"; returns 1 when no manifest.
detect_dependency_install() {
  local root="$1" found
  if [ -f "$root/pyproject.toml" ]; then printf 'uv sync\t.'; return 0; fi
  if [ -f "$root/package-lock.json" ]; then printf 'npm ci\t.'; return 0; fi
  # sort keeps the pick deterministic across filesystems.
  found=$(cd "$root" && find . -mindepth 2 -maxdepth 2 -name pyproject.toml \
    -not -path './.git/*' 2>/dev/null | sort | head -1)
  if [ -n "$found" ]; then printf 'uv sync\t%s' "$(dirname "${found#./}")"; return 0; fi
  found=$(cd "$root" && find . -mindepth 2 -maxdepth 2 -name package-lock.json \
    -not -path './.git/*' 2>/dev/null | sort | head -1)
  if [ -n "$found" ]; then printf 'npm ci\t%s' "$(dirname "${found#./}")"; return 0; fi
  return 1
}

# Verify once, at run start, that the container can actually build the target
# repo's dependencies. Without this the failure is rediscovered independently
# by every agent in every cycle — each reporting "lint/tests blocked" — while
# unverified code keeps getting pushed for the whole run. Result is surfaced to
# the reviewer so it never demands test evidence the agents provably cannot
# produce, and to the operator as a startup banner.
# Sets: TOOLCHAIN_STATUS (one-liner injected into the reviewer prompt)
# Uses globals: REPO_ABS BASE_BRANCH LOG_DIR ENV_FILE IMAGE TIMEOUT_MIN
toolchain_preflight() {
  TOOLCHAIN_STATUS=""

  local detected install_cmd manifest_dir
  if ! detected=$(detect_dependency_install "$REPO_ABS"); then
    TOOLCHAIN_STATUS="No Python or Node manifest found — dependency preflight skipped."
    echo "Toolchain preflight: no manifest found, skipping."
    return 0
  fi
  install_cmd="${detected%%$'\t'*}"
  manifest_dir="${detected##*$'\t'}"

  echo "Toolchain preflight: running \`$install_cmd\` in ${manifest_dir}/ ..."

  local preflight_dir preflight_log rc
  preflight_dir=$(mktemp -d /tmp/alucard_preflight.XXXXXX)
  CREATED_WORKTREES+=("$preflight_dir")
  preflight_log="$LOG_DIR/toolchain-preflight.txt"

  if ! git clone --local --no-tags --single-branch --branch "$BASE_BRANCH" \
       "$REPO_ABS" "$preflight_dir" >/dev/null 2>&1; then
    TOOLCHAIN_STATUS="Preflight clone of ${BASE_BRANCH} failed — dependency build unverified."
    echo "Toolchain preflight: clone failed, skipping."
    return 0
  fi

  set +e
  timeout "${TIMEOUT_MIN}m" docker run --rm \
    --name "alucard-preflight-$$" \
    --network bridge \
    --memory 4g --cpus 2 \
    --read-only \
    --tmpfs /tmp:exec,size=2g \
    --tmpfs "/home/alucard:size=2g,uid=$(id -u),gid=$(id -g)" \
    --ulimit "nofile=8192:8192" \
    --user "$(id -u):$(id -g)" \
    --security-opt no-new-privileges \
    --cap-drop ALL \
    --env-file "$ENV_FILE" \
    -e "HOME=/home/alucard" \
    -v "$preflight_dir:/work:rw" \
    -w "/work/${manifest_dir}" \
    "$IMAGE" \
    bash -lc "$install_cmd" >"$preflight_log" 2>&1
  rc=$?
  set -e

  rm -rf "$preflight_dir" || true

  if [ "$rc" -eq 0 ]; then
    TOOLCHAIN_STATUS="OK — \`$install_cmd\` completes in the container. Agents can run this repo's lint and test suite; missing test evidence is a real gap."
    echo "Toolchain preflight: OK."
    return 0
  fi

  TOOLCHAIN_STATUS="BROKEN — \`$install_cmd\` fails in ${manifest_dir}/ inside the container (rc=${rc}). Agents CANNOT install dependencies, so they cannot run this repo's lint or test suite. Do not raise findings that require local test execution or test output as evidence; they are unfixable until the container image is repaired."
  echo ""
  echo "########################################################################"
  echo "# TOOLCHAIN PREFLIGHT FAILED"
  echo "#"
  echo "#   \`$install_cmd\` in ${manifest_dir}/ exited $rc inside $IMAGE."
  echo "#   Agents will NOT be able to run this repo's lint or test suite,"
  echo "#   so every push this run is unverified."
  echo "#"
  echo "#   Full output: $preflight_log"
  echo "#   Last lines:"
  # Command substitution strips trailing newlines, so printf restores exactly
  # one — a log without a final newline would otherwise eat the closing rule.
  printf '%s\n' "$(tail -15 "$preflight_log" 2>/dev/null | sed 's/^/#     /')"
  echo "########################################################################"
  echo ""
  return 0
}

setup_run_environment() {
  REPO_ABS=$(resolve_repo "$TARGET_REPO")
  [ -d "$(dirname "$ENV_FILE")" ] || die "env file directory does not exist: $(dirname "$ENV_FILE")"
  ENV_FILE="$(cd "$(dirname "$ENV_FILE")" && pwd)/$(basename "$ENV_FILE")"
  LOG_ROOT="$(mkdir -p "$LOG_ROOT" && cd "$LOG_ROOT" && pwd)"
  LOG_DIR="$LOG_ROOT/alucard-$(date +%Y%m%d-%H%M%S)"
  WT_ROOT="${REPO_ABS}/.alucard-worktrees"

  mkdir -p "$LOG_DIR" "$WT_ROOT"
  load_env_file "$ENV_FILE" true
  ensure_image "$IMAGE" "$AUTO_BUILD"

  stream_text='select(.type == "stream_event" and .event.type == "content_block_delta" and .event.delta.type == "text_delta") | .event.delta.text'
  codex_stream_text='select(.type == "item.completed") | if .item.type == "agent_message" then .item.text + "\n" elif .item.type == "command_execution" then "$ " + (.item.command | split("\n")[0] | .[0:200]) + "\n" else empty end'
  CREATED_WORKTREES=()

  cleanup() {
    local wt
    for wt in "${CREATED_WORKTREES[@]}"; do
      rm -rf "$wt"
    done
    print_usage_report "$LOG_DIR"
  }
  trap cleanup EXIT

  toolchain_preflight
}

# Build the worker prompt for one iteration. GitHub mode injects the whole
# queue and the worker picks; file mode injects exactly ONE task — the first
# eligible in file order — plus the plan's parent context, so bundling and
# mispicking are structurally impossible. Sets FULL_PROMPT and, in file mode,
# DISPATCHED_TASK_ID (used for PR linkage and recovery attribution).
build_worker_prompt() {
  local queue="$1" commits="$2" instructions="$3"
  local _commits_esc _task _task_esc _parent_esc _issues_esc

  _commits_esc=$(printf '%s' "$commits" | xml_escape)
  DISPATCHED_TASK_ID=""

  if [ "$TASK_SOURCE" = "file" ]; then
    _task=$(echo "$queue" | jq -c '.[0]')
    DISPATCHED_TASK_ID=$(echo "$_task" | jq -r '.id')
    _task_esc=$(printf '%s' "$_task" | xml_escape)
    _parent_esc=$(parse_tasks_file "$TASKS_FILE_ABS" | jq -r '.parent_context' | xml_escape)
    FULL_PROMPT="<instructions>${instructions}</instructions>
<task_source>file</task_source>
<base_branch>${BASE_BRANCH}</base_branch>
<commits>${_commits_esc}</commits>
<parent_context>${_parent_esc}</parent_context>
<task>${_task_esc}</task>"
    TASK_XML="$_task_esc"
    PARENT_CONTEXT_XML="$_parent_esc"
  else
    _issues_esc=$(printf '%s' "$queue" | xml_escape)
    FULL_PROMPT="<instructions>${instructions}</instructions>
<base_branch>${BASE_BRANCH}</base_branch>
<commits>${_commits_esc}</commits>
<issues>${_issues_esc}</issues>"
    TASK_XML=""
    PARENT_CONTEXT_XML=""
  fi
}

command_run() {
  parse_repo_options "$@"

  need_cmd git
  need_cmd gh
  need_cmd jq
  need_cmd docker
  need_cmd timeout

  [ "$ITERATIONS" -gt 0 ] || die "iterations must be greater than zero"
  [ "$TIMEOUT_MIN" -gt 0 ] || die "timeout must be greater than zero"

  setup_run_environment
  resolve_task_source "$REPO_ABS"
  [ "$TASK_SOURCE" = "github" ] || echo "Local task source: $TASKS_FILE_ABS"
  local final_result='select(.type == "result").result // empty'

  for ((i=1; i<=ITERATIONS; i++)); do
    echo "=== alucard iteration $i/$ITERATIONS ==="

    WT_HOST="${WT_ROOT}/iter-$i"
    BRANCH="alucard/iter-${i}-$(date +%s)"
    CREATED_WORKTREES+=("$WT_HOST")

    # Clean up any stale directory from a previous interrupted run.
    rm -rf "$WT_HOST"

    # Clone locally so the container gets a self-contained .git dir.
    # Worktrees leave a .git file pointing to the host path, which the
    # container cannot resolve.
    # Explicit refspec so the remote-tracking ref is updated without touching
    # the local branch (which may be checked out and thus un-forceable).
    git -C "$REPO_ABS" fetch origin "+refs/heads/$BASE_BRANCH:refs/remotes/origin/$BASE_BRANCH"
    git clone --local --no-tags --single-branch --branch "$BASE_BRANCH" "$REPO_ABS" "$WT_HOST"
    # The local branch may be behind; reset the clone to the exact fetched commit.
    git -C "$WT_HOST" reset --hard "$(git -C "$REPO_ABS" rev-parse "origin/$BASE_BRANCH")"
    # Snapshot the base SHA the worker starts from. The worktree's own
    # `origin/$BASE_BRANCH` tracks REPO_ABS's *local* main, which is frozen at
    # the cached clone's creation time — so it drifts behind the real GitHub
    # main over time and `origin/main..HEAD` reports phantom commits the worker
    # never made. Using a pinned base SHA measures only what this iteration
    # added on top of where it started.
    _base_sha="$(git -C "$WT_HOST" rev-parse HEAD)"
    # Always use HTTPS so the container can authenticate with GITHUB_TOKEN.
    # Convert git@github.com:owner/repo.git → https://github.com/owner/repo.git
    _origin_url="$(git -C "$REPO_ABS" remote get-url origin)"
    _origin_url="${_origin_url/git@github.com:/https://github.com/}"
    git -C "$WT_HOST" remote set-url origin "$_origin_url"
    git -C "$WT_HOST" checkout -b "$BRANCH"

    issues=$(get_task_queue "$REPO_ABS")
    count=$(echo "$issues" | jq 'length')

    if [ "$count" -eq 0 ]; then
      echo "Queue empty. Alucard rests after $((i-1)) iterations."
      rm -rf "$WT_HOST"
      exit 0
    fi

    commits=$(git -C "$REPO_ABS" log -n 5 --format="%H%n%ad%n%B---" --date=short "origin/$BASE_BRANCH")
    prompt=$(<"$TOOL_DIR/alucard-worker-prompt.md")
    log_file="$LOG_DIR/iter-${i}.jsonl"

    build_worker_prompt "$issues" "$commits" "$prompt"
    full_prompt="$FULL_PROMPT"
    if [ "$TASK_SOURCE" = "file" ]; then
      echo "Dispatching task ${DISPATCHED_TASK_ID}: $(echo "$issues" | jq -r '.[0].title')"
    fi

    ITER_STARTED_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    # Snapshot which issues are already in-progress so we can detect what the
    # worker newly claimed and roll that label back if it never opened a PR.
    # Local mode has no claim step — nothing to snapshot or roll back.
    _in_progress_before="[]"
    if [ "$TASK_SOURCE" = "github" ]; then
      _in_progress_before=$(cd "$REPO_ABS" && \
        gh issue list --state open --label in-progress --limit 500 --json number \
          --jq '[.[].number]' 2>/dev/null || echo '[]')
    fi

    set +e
    invoke_agent \
      "iter-$i" \
      "$log_file" \
      "$DEFAULT_WORKER_MAX_TURNS" "$DEFAULT_WORKER_MAX_BUDGET" \
      "$full_prompt" \
      -v "$WT_HOST:/work:rw" \
      -e "ALUCARD_ITER=$i"
    rc=$?
    set -e

    # Provider billing failure is terminal — re-running 20 iterations against
    # the same exhausted account just burns time and leaks stub branches. Bail
    # the whole run on the first sighting so the user can top up and retry.
    if [ -f "$log_file" ] && grep -q '"error":"billing_error"' "$log_file"; then
      echo "alucard: provider returned billing_error (credit balance too low) — aborting run."
      rm -rf "$WT_HOST"
      exit 2
    fi

    # Worker should push to $BRANCH, but may misbehave and push to a custom
    # branch (e.g. integration branch). If head-branch lookup finds no PR,
    # fall back to the newest alucard-labeled OPEN PR opened during this
    # iteration — otherwise the gates and token-usage post would silently skip.
    ACTUAL_BRANCH="$BRANCH"
    _pr_found=false
    _iter_pr_num=""
    _harness_pr=$(cd "$REPO_ABS" && \
      gh pr list --head "$BRANCH" --state open --json number \
        --jq '.[0].number // empty' 2>/dev/null || true)
    if [ -n "${_harness_pr:-}" ]; then
      _pr_found=true
      _iter_pr_num="$_harness_pr"
    else
      _fallback=$(cd "$REPO_ABS" && \
        gh pr list --label alucard --state open --json number,createdAt,headRefName \
          --jq --arg since "$ITER_STARTED_AT" \
          '[.[] | select(.createdAt > $since)] | sort_by(.createdAt) | last // empty' \
        2>/dev/null || true)
      if [ -n "${_fallback:-}" ] && [ "$_fallback" != "null" ]; then
        ACTUAL_BRANCH=$(echo "$_fallback" | jq -r '.headRefName')
        _fallback_num=$(echo "$_fallback" | jq -r '.number')
        echo "Worker pushed to non-harness branch '$ACTUAL_BRANCH' — using PR #$_fallback_num for gates."
        _pr_found=true
        _iter_pr_num="$_fallback_num"
      fi
    fi
    _recovery_pr=false

    # Local source: mark the dispatched task in-flight so the next iteration
    # skips it while the PR is open. This is the local analog of GitHub's
    # closing-issues dedup. A miss means the heading was edited mid-run —
    # stop before the loop dispatches the same task twice.
    if [ "$TASK_SOURCE" = "file" ] && [ "$_pr_found" = true ]; then
      mark_task_in_flight "$TASKS_FILE_ABS" "$DISPATCHED_TASK_ID" "$_iter_pr_num" \
        || die "could not mark task ${DISPATCHED_TASK_ID} in-flight in $TASKS_FILE_ABS (heading edited mid-run?) — PR #${_iter_pr_num} is pushed and safe; fix the heading, then resume gates with 'alucard continue ${_iter_pr_num}'"
    fi

    # Worker exited (timeout, budget, error) before opening a PR. Two failure
    # modes to recover from:
    #   1. Worker made commits but was killed before `git push` / `gh pr create`
    #      — the worktree is about to be deleted, so push it now and open a
    #      draft recovery PR so `alucard continue <PR_NUM>` can resume.
    #   2. Worker claimed an issue (`gh issue edit <N> --add-label in-progress`)
    #      but never produced any commits — strip the label so the queue filter
    #      doesn't lock the issue out of future runs.
    if [ "$_pr_found" = false ]; then
      _newly_claimed="[]"
      if [ "$TASK_SOURCE" = "github" ]; then
        _in_progress_after=$(cd "$REPO_ABS" && \
          gh issue list --state open --label in-progress --limit 500 --json number \
            --jq '[.[].number]' 2>/dev/null || echo '[]')
        _newly_claimed=$(jq -nc \
          --argjson before "$_in_progress_before" \
          --argjson after "$_in_progress_after" \
          '$after - $before' 2>/dev/null || echo '[]')
      fi

      if [ -d "$WT_HOST/.git" ]; then
        # Stage and commit any uncommitted changes — work-in-progress would
        # otherwise die with the worktree.
        if [ -n "$(git -C "$WT_HOST" status --porcelain 2>/dev/null)" ]; then
          echo "Worker left uncommitted changes — committing for recovery."
          git -C "$WT_HOST" add -A 2>/dev/null || true
          git -C "$WT_HOST" \
            -c user.email=alucard@noreply.local \
            -c user.name=alucard \
            commit -m "wip: alucard recovery — uncommitted worker state" \
            2>/dev/null || true
        fi
        # Compare against the SHA pinned at clone time, not the worktree's
        # `origin/$BASE_BRANCH` ref — that ref tracks REPO_ABS's stale local
        # main and reports phantom commits whenever GitHub main has advanced
        # since REPO_ABS was first cloned.
        _commits_ahead=$(git -C "$WT_HOST" rev-list --count \
          "${_base_sha}..HEAD" 2>/dev/null || echo 0)
        if [ "$_commits_ahead" -gt 0 ]; then
          _recover_branch=$(git -C "$WT_HOST" rev-parse --abbrev-ref HEAD \
            2>/dev/null || echo "$BRANCH")
          echo "Worker rc=$rc left $_commits_ahead commit(s) on $_recover_branch — pushing to preserve work."
          # Recovery push runs on the host, not in the container. The worktree's
          # origin was rewritten to HTTPS so the in-container worker could auth
          # via GITHUB_TOKEN, but the host has no HTTPS credential helper — that
          # push would hang on an interactive `Username for https://github.com:`
          # prompt. Flip origin back to the cached clone's URL (proven to work
          # for host-side fetch) before pushing, and disable terminal prompts so
          # any future remote-URL mishap fails loudly instead of wedging.
          _host_origin_url="$(git -C "$REPO_ABS" remote get-url origin)"
          git -C "$WT_HOST" remote set-url origin "$_host_origin_url"
          if GIT_TERMINAL_PROMPT=0 git -C "$WT_HOST" push -u origin "$_recover_branch" 2>&1; then
            # Closes #N on the first line lets the queue dedup filter
            # (closingIssuesReferences in get_unblocked_afk_issues) match
            # the issue to this PR so the issue isn't re-picked. The local
            # source uses a Task: line plus the in-flight heading flip below.
            _closes_line=""
            if [ "$TASK_SOURCE" = "file" ]; then
              _closes_line="Task: ${DISPATCHED_TASK_ID}"
            else
              for _n in $(echo "$_newly_claimed" | jq -r '.[]' 2>/dev/null); do
                _closes_line="Closes #${_n}"
                break
              done
            fi
            _stub_body="${_closes_line}

**🤖 Alucard recovery PR** — worker exited rc=${rc} before opening a PR. Its commits have been pushed here so the work isn't lost.

Resume with \`alucard continue <PR_NUM>\` once you've vetted the changes, or close this PR if the work isn't salvageable."
            _stub_title="wip: alucard recovery — iter ${i} (worker killed rc=${rc})"
            if _new_pr_url=$(cd "$REPO_ABS" && \
              gh pr create \
                --head "$_recover_branch" \
                --base "$BASE_BRANCH" \
                --label alucard \
                --draft \
                --title "$_stub_title" \
                --body "$_stub_body" 2>&1); then
              echo "Opened recovery PR: $_new_pr_url"
              ACTUAL_BRANCH="$_recover_branch"
              _recovery_pr=true
              if [ "$TASK_SOURCE" = "file" ]; then
                _recovery_pr_num="${_new_pr_url##*/}"
                mark_task_in_flight "$TASKS_FILE_ABS" "$DISPATCHED_TASK_ID" "$_recovery_pr_num" \
                  || die "could not mark task ${DISPATCHED_TASK_ID} in-flight in $TASKS_FILE_ABS — recovery PR #${_recovery_pr_num} is pushed and safe; fix the heading before the next run"
              fi
            else
              echo "Could not open recovery PR: $_new_pr_url"
            fi
          else
            echo "Could not push $_recover_branch to origin — work is lost."
          fi
        fi
      fi

      # No PR exists and recovery didn't produce one — strip the in-progress
      # label so the next run can re-pick the issue. Local mode never
      # claimed anything, so there is nothing to strip and the still-"[ ]"
      # task is naturally re-picked next iteration.
      if [ "$_recovery_pr" = false ] && [ "$TASK_SOURCE" = "github" ]; then
        for _n in $(echo "$_newly_claimed" | jq -r '.[]' 2>/dev/null); do
          echo "Worker claimed #$_n but produced no PR — removing 'in-progress' label."
          (cd "$REPO_ABS" && gh issue edit "$_n" --remove-label in-progress) \
            2>/dev/null || true
        done
      fi
    fi

    rm -rf "$WT_HOST" || true

    # Skip CI/review gates on recovery PRs — the work is incomplete by
    # definition. The user should vet the diff and run `alucard continue`
    # to resume gates against the recovered branch.
    if [ "$_recovery_pr" = false ]; then
      ci_gate "$i" "$ACTUAL_BRANCH" "$_origin_url"
      review_gate "$i" "$ACTUAL_BRANCH" "$_origin_url" "$TASK_XML" "$PARENT_CONTEXT_XML"
    fi
    post_iteration_usage "$i" "$ACTUAL_BRANCH" "$REPO_ABS" "$LOG_DIR"

    if [ "$rc" -ne 0 ]; then
      echo "Iteration $i exited rc=$rc. Continuing."
      continue
    fi

    result=$(jq -r "$final_result" "$log_file" 2>/dev/null || echo "")
    if [[ "$result" == *"<promise>NO MORE TASKS</promise>"* ]]; then
      # Verify before trusting — a wedged worker (e.g. sandbox CWD got deleted
      # mid-iteration, all subsequent tools fail) also emits this promise as a
      # last resort. Trust it only if the queue is independently empty. A
      # query failure here falls through to "keep going" rather than exit,
      # since a transient GitHub blip shouldn't kill a 20-iter overnight run.
      _remaining=""
      _remaining=$(get_task_queue "$REPO_ABS" | jq 'length' 2>/dev/null || true)
      if [ "${_remaining:-}" = "0" ]; then
        echo "Alucard signaled completion after $i iterations (queue verified empty)."
        exit 0
      fi
      echo "Worker promised NO MORE TASKS but queue still has ${_remaining:-unknown} unblocked issue(s) — ignoring (likely a wedged iteration). Continuing."
    fi
  done

  echo "Reached max iterations ($ITERATIONS)."
}

command_continue() {
  local pr_arg="${1:-}"
  is_uint "$pr_arg" || die "usage: alucard continue <PR_NUM> [options] — PR_NUM must be a positive integer"
  local pr_num="$pr_arg"
  shift

  parse_repo_options "$@"

  need_cmd git
  need_cmd gh
  need_cmd jq
  need_cmd docker
  need_cmd timeout

  local _early_repo pr_json pr_state branch
  _early_repo=$(resolve_repo "$TARGET_REPO")
  pr_json=$(cd "$_early_repo" && \
    gh pr view "$pr_num" --json state,headRefName 2>/dev/null) \
    || die "PR #$pr_num not found in target repo"
  pr_state=$(echo "$pr_json" | jq -r '.state')
  [ "$pr_state" = "OPEN" ] || die "PR #$pr_num is not open (state: $pr_state)"
  branch=$(echo "$pr_json" | jq -r '.headRefName')

  setup_run_environment

  local origin_url
  origin_url="$(git -C "$REPO_ABS" remote get-url origin)"
  origin_url="${origin_url/git@github.com:/https://github.com/}"

  local iter
  iter="continue-$(date +%s)"

  echo "=== alucard continue: PR #$pr_num on $branch (iter $iter) ==="

  # Build review_findings: last CHANGES_REQUESTED bot comment + all subsequent human comments.
  # If no CHANGES_REQUESTED bot comment exists, fall back to all non-bot comments.
  local _comments_json last_bot_cr_body bot_cr_time human_after feedback_findings
  _comments_json=$(cd "$REPO_ABS" && \
    gh pr view "$pr_num" --json comments 2>/dev/null || echo '{"comments":[]}')

  last_bot_cr_body=$(echo "$_comments_json" | jq -r \
    '.comments | map(select(.body | startswith("**🤖 Alucard") and contains("CHANGES_REQUESTED"))) | last | .body // empty' \
    2>/dev/null || true)
  bot_cr_time=$(echo "$_comments_json" | jq -r \
    '.comments | map(select(.body | startswith("**🤖 Alucard") and contains("CHANGES_REQUESTED"))) | last | .createdAt // empty' \
    2>/dev/null || true)

  if [ -n "${last_bot_cr_body:-}" ]; then
    human_after=""
    if [ -n "${bot_cr_time:-}" ]; then
      human_after=$(echo "$_comments_json" | jq -r \
        --arg since "$bot_cr_time" \
        '[.comments[] | select((.body | startswith("**🤖 Alucard") | not) and .createdAt > $since) | "- @\(.author.login) at \(.createdAt):\n\(.body)"] | join("\n\n")' \
        2>/dev/null || true)
    fi
    feedback_findings="$last_bot_cr_body"
    if [ -n "${human_after:-}" ]; then
      feedback_findings="${feedback_findings}

---

## Additional human PR comments

Treat each as an additional finding when actionable and on-topic. Off-topic or out-of-scope comments should be acknowledged via \`gh pr comment --body-file <file>\` rather than silently ignored.

${human_after}"
    fi
  else
    local all_human
    all_human=$(echo "$_comments_json" | jq -r \
      '[.comments[] | select(.body | startswith("**🤖 Alucard") | not) | "- @\(.author.login) at \(.createdAt):\n\(.body)"] | join("\n\n")' \
      2>/dev/null || true)
    if [ -n "${all_human:-}" ]; then
      feedback_findings="$all_human"
    fi
  fi

  if [ -n "${feedback_findings:-}" ]; then
    run_feedback_once "$iter" "$branch" "$origin_url" "$pr_num" "$feedback_findings" 1
  else
    echo "No actionable comments on PR #$pr_num — skipping feedback; running gates only."
  fi
  ci_gate "$iter" "$branch" "$origin_url"
  review_gate "$iter" "$branch" "$origin_url"
  post_iteration_usage "$iter" "$branch" "$REPO_ABS" "$LOG_DIR"
}

main() {
  if [ "$#" -eq 0 ]; then
    usage
    exit 0
  fi

  if is_uint "${1:-}"; then
    local old_iterations="$1"
    shift
    if is_uint "${1:-}"; then
      local old_timeout="$1"
      shift
      set -- run --iterations "$old_iterations" --timeout-minutes "$old_timeout" "$@"
    else
      set -- run --iterations "$old_iterations" "$@"
    fi
  fi

  local command="$1"
  shift || true

  case "$command" in
    run)
      command_run "$@"
      ;;
    queue)
      command_queue "$@"
      ;;
    build)
      command_build "$@"
      ;;
    doctor)
      command_doctor "$@"
      ;;
    continue)
      command_continue "$@"
      ;;
    version|--version|-V)
      command_version
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      if [ -d "$command" ]; then
        command_run "$command" "$@"
      else
        die "unknown command: $command"
      fi
      ;;
  esac
}

[[ "${BASH_SOURCE[0]}" != "${0}" ]] || main "$@"
